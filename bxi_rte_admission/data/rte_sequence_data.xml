<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_rte_lottery_batch" model="ir.sequence">
        <field name="name">RTE Lottery Batch</field>
        <field name="code">rte.lottery.batch</field>
        <field name="prefix">RTE/LOT/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_rte_reimbursement_claim" model="ir.sequence">
        <field name="name">RTE Reimbursement Claim</field>
        <field name="code">rte.reimbursement.claim</field>
        <field name="prefix">RTE/REIM/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_rte_grievance" model="ir.sequence">
        <field name="name">RTE Grievance</field>
        <field name="code">rte.grievance</field>
        <field name="prefix">RTE/GRV/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
