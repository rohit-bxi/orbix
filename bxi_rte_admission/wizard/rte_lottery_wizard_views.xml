<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rte_lottery_wizard_form" model="ir.ui.view">
        <field name="name">rte.lottery.wizard.form</field>
        <field name="model">rte.lottery.wizard</field>
        <field name="arch" type="xml">
            <form string="Run RTE Lottery">
                <group>
                    <field name="course_id"
                           options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="academic_year_id"
                           options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="random_seed"/>
                </group>
                <footer>
                    <button string="Create &amp; Run Lottery" type="object"
                            name="action_create_and_run" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="act_rte_lottery_wizard" model="ir.actions.act_window">
        <field name="name">Run RTE Lottery</field>
        <field name="res_model">rte.lottery.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
