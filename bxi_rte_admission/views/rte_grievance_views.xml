<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rte_grievance_list" model="ir.ui.view">
        <field name="name">rte.grievance.list</field>
        <field name="model">rte.grievance</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="admission_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_rte_grievance_form" model="ir.ui.view">
        <field name="name">rte.grievance.form</field>
        <field name="model">rte.grievance</field>
        <field name="arch" type="xml">
            <form string="RTE Grievance">
                <header>
                    <button name="action_submit" string="Submit" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_cbeo_resolve" string="Resolve (CBEO)" type="object"
                            class="oe_highlight" invisible="state != 'submitted'"/>
                    <button name="action_escalate_to_jd" string="Escalate to Joint Director"
                            type="object" invisible="state != 'submitted'"/>
                    <button name="action_jd_resolve" string="Resolve (Joint Director)"
                            type="object" class="oe_highlight"
                            invisible="state != 'escalated_jd'"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state not in ('submitted', 'escalated_jd')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,resolved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <field name="admission_id"
                               options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="description"/>
                    </group>
                    <group string="Resolution" invisible="state == 'draft'">
                        <field name="cbeo_resolution_notes"/>
                        <field name="jd_resolution_notes" invisible="state != 'escalated_jd' and not jd_resolution_notes"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="act_open_rte_grievance_view" model="ir.actions.act_window">
        <field name="name">Grievances</field>
        <field name="res_model">rte.grievance</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
