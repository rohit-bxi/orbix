<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rte_class_enrollment_stat_list" model="ir.ui.view">
        <field name="name">rte.class.enrollment.stat.list</field>
        <field name="model">rte.class.enrollment.stat</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="course_id" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="entry_class"/>
                <field name="academic_year_id" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="paid_enrolled_count"/>
                <field name="promoted_free_count"/>
            </list>
        </field>
    </record>

    <record id="act_open_rte_class_enrollment_stat_view" model="ir.actions.act_window">
        <field name="name">Paid Enrollment Statistics</field>
        <field name="res_model">rte.class.enrollment.stat</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
