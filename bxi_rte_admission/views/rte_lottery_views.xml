<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- rte.lottery.batch -->
    <record id="view_rte_lottery_batch_list" model="ir.ui.view">
        <field name="name">rte.lottery.batch.list</field>
        <field name="model">rte.lottery.batch</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="course_id"/>
                <field name="academic_year_id"/>
                <field name="draw_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_rte_lottery_batch_form" model="ir.ui.view">
        <field name="name">rte.lottery.batch.form</field>
        <field name="model">rte.lottery.batch</field>
        <field name="arch" type="xml">
            <form string="RTE Lottery Batch">
                <header>
                    <button name="action_mark_ready" string="Mark Ready" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="run_lottery" string="Run Lottery" type="object"
                            class="oe_highlight" invisible="state != 'ready'"/>
                    <button name="action_publish" string="Publish Results" type="object"
                            class="oe_highlight" invisible="state != 'run'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="course_id" readonly="state != 'draft'"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="academic_year_id" readonly="state != 'draft'"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                        </group>
                        <group>
                            <field name="random_seed" readonly="state != 'draft'"/>
                            <field name="effective_seats" readonly="1"/>
                            <field name="draw_date" readonly="1"/>
                            <field name="applicant_hash" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Results" name="results">
                            <field name="result_ids" readonly="1">
                                <list>
                                    <field name="rank"/>
                                    <field name="admission_id"/>
                                    <field name="result_type" widget="badge"/>
                                    <field name="preference_matched"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="act_open_rte_lottery_batch_view" model="ir.actions.act_window">
        <field name="name">Lottery Batches</field>
        <field name="res_model">rte.lottery.batch</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- rte.lottery.result -->
    <record id="view_rte_lottery_result_list" model="ir.ui.view">
        <field name="name">rte.lottery.result.list</field>
        <field name="model">rte.lottery.result</field>
        <field name="arch" type="xml">
            <list>
                <field name="batch_id"/>
                <field name="admission_id"/>
                <field name="rank"/>
                <field name="result_type" widget="badge"/>
                <field name="preference_matched"/>
            </list>
        </field>
    </record>

    <record id="act_open_rte_lottery_result_view" model="ir.actions.act_window">
        <field name="name">Lottery Results</field>
        <field name="res_model">rte.lottery.result</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
