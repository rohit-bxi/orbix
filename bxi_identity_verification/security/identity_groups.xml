<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_identity" model="ir.module.category">
        <field name="name">Identity Verification</field>
        <field name="sequence">30</field>
    </record>

    <record id="privilege_identity" model="res.groups.privilege">
        <field name="name">Identity Verification</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_identity"/>
    </record>

    <record id="group_identity_reviewer" model="res.groups">
        <field name="name">Identity Reviewer</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_identity"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
