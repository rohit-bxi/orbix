<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_report_transport_route_manifest" model="ir.actions.report">
        <field name="name">Route Manifest</field>
        <field name="model">bxi.transport.route</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bxi_school_transport_bus_management.transport_route_manifest_template</field>
        <field name="report_file">bxi_school_transport_bus_management.transport_route_manifest_template</field>
        <field name="print_report_name">'Route Manifest - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_bxi_transport_route"/>
        <field name="binding_type">report</field>
    </record>

    <template id="transport_route_manifest_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <div class="page">
                        <h1 style="text-align:center;text-decoration:underline;">Bus Route Manifest</h1>
                        <div class="row">
                            <div class="col-6">
                                <strong>Route:</strong> <span t-field="doc.name"/><br/>
                                <strong>Bus:</strong> <span t-field="doc.vehicle_id.name"/><br/>
                                <strong>Driver:</strong> <span t-field="doc.driver_id.name"/>
                            </div>
                            <div class="col-6">
                                <strong>Attendant:</strong> <span t-field="doc.attendant_id.name"/><br/>
                                <strong>Capacity:</strong> <span t-field="doc.capacity"/><br/>
                                <strong>Academic Year:</strong> <span t-field="doc.academic_year_id.name"/>
                            </div>
                        </div>
                        <br/>
                        <table class="table table-bordered" style="width:100%">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Stop</th>
                                    <th>Pickup</th>
                                    <th>Drop</th>
                                    <th>Student</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.stop_ids" t-as="stop">
                                    <t t-foreach="stop.registration_ids.filtered(lambda r: r.state != 'cancelled')" t-as="reg">
                                        <tr>
                                            <td><span t-esc="stop_index + 1"/></td>
                                            <td><span t-field="stop.name"/></td>
                                            <td><span t-field="stop.pickup_time" t-options="{'widget': 'float_time'}"/></td>
                                            <td><span t-field="stop.drop_time" t-options="{'widget': 'float_time'}"/></td>
                                            <td><span t-field="reg.student_id.name"/></td>
                                            <td><span t-field="reg.state"/></td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
