<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_transport_driver_list" model="ir.ui.view">
        <field name="name">bxi.transport.driver.list</field>
        <field name="model">bxi.transport.driver</field>
        <field name="arch" type="xml">
            <list string="Transport Drivers" decoration-danger="license_expiring_soon">
                <field name="name"/>
                <field name="license_number"/>
                <field name="license_type"/>
                <field name="license_expiry"/>
                <field name="vehicle_id"/>
                <field name="status" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_transport_driver_form" model="ir.ui.view">
        <field name="name">bxi.transport.driver.form</field>
        <field name="model">bxi.transport.driver</field>
        <field name="arch" type="xml">
            <form string="Transport Driver">
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button class="oe_stat_button" type="object" name="action_view_vehicle" icon="fa-bus"
                                invisible="not vehicle_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Assigned Bus</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="License Expiring Soon" bg_color="text-bg-warning"
                            invisible="not license_expiring_soon"/>
                    <div class="oe_title">
                        <h1>
                            <field name="partner_id"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="phone"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="license_number"/>
                            <field name="license_type"/>
                            <field name="license_expiry"/>
                            <field name="badge_verified"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_transport_driver_search" model="ir.ui.view">
        <field name="name">bxi.transport.driver.search</field>
        <field name="model">bxi.transport.driver</field>
        <field name="arch" type="xml">
            <search string="Transport Drivers">
                <field name="partner_id"/>
                <field name="license_number"/>
                <filter string="License Expiring Soon" name="expiring_soon"
                        domain="[('license_expiring_soon', '=', True)]"/>
                <filter string="Active" name="active_status" domain="[('status', '=', 'active')]"/>
                <group name="group_by">
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_transport_driver" model="ir.actions.act_window">
        <field name="name">Drivers</field>
        <field name="res_model">bxi.transport.driver</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_transport_driver_search"/>
    </record>
</odoo>
