<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_transport_route_list" model="ir.ui.view">
        <field name="name">bxi.transport.route.list</field>
        <field name="model">bxi.transport.route</field>
        <field name="arch" type="xml">
            <list string="Bus Routes" decoration-muted="state == 'archived'">
                <field name="name"/>
                <field name="code" optional="hide"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="capacity"/>
                <field name="seats_available"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'active'"
                       decoration-muted="state == 'archived'"/>
            </list>
        </field>
    </record>

    <record id="view_transport_route_form" model="ir.ui.view">
        <field name="name">bxi.transport.route.form</field>
        <field name="model">bxi.transport.route</field>
        <field name="arch" type="xml">
            <form string="Bus Route">
                <header>
                    <button name="action_activate" type="object" string="Activate" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_archive_route" type="object" string="Archive"
                            invisible="state != 'active'"/>
                    <button name="action_set_draft" type="object" string="Reset to Draft"
                            invisible="state != 'archived'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active"/>
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button class="oe_stat_button" type="object" name="action_view_registrations" icon="fa-users">
                            <field string="Registrations" name="registration_count" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Route Name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                        <field name="code" placeholder="Route Code"/>
                    </div>
                    <group>
                        <group>
                            <field name="vehicle_id"/>
                            <field name="driver_id" readonly="1"/>
                            <field name="attendant_id" readonly="1"/>
                            <field name="academic_year_id"/>
                        </group>
                        <group>
                            <field name="capacity" readonly="1"/>
                            <field name="seats_available" readonly="1"/>
                            <field name="distance_km"/>
                            <field name="fee_product_id"/>
                            <field name="fee_amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Stops" name="stops">
                            <field name="stop_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="pickup_time" widget="float_time"/>
                                    <field name="drop_time" widget="float_time"/>
                                    <field name="fee_amount"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_transport_route_search" model="ir.ui.view">
        <field name="name">bxi.transport.route.search</field>
        <field name="model">bxi.transport.route</field>
        <field name="arch" type="xml">
            <search string="Bus Routes">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <filter string="Active" name="active_routes" domain="[('state', '=', 'active')]"/>
                <filter string="Draft" name="draft_routes" domain="[('state', '=', 'draft')]"/>
                <group name="group_by">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Bus" name="group_vehicle" context="{'group_by': 'vehicle_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_transport_route" model="ir.actions.act_window">
        <field name="name">Bus Routes</field>
        <field name="res_model">bxi.transport.route</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_transport_route_search"/>
    </record>
</odoo>
