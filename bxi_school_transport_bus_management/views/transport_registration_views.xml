<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_transport_registration_list" model="ir.ui.view">
        <field name="name">bxi.transport.registration.list</field>
        <field name="model">bxi.transport.registration</field>
        <field name="arch" type="xml">
            <list string="Transport Registrations" decoration-danger="state == 'cancelled'"
                  decoration-success="state == 'active'">
                <field name="name"/>
                <field name="student_id"/>
                <field name="route_id"/>
                <field name="stop_id"/>
                <field name="date_start"/>
                <field name="fee_amount"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'confirmed'"
                       decoration-success="state == 'active'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_transport_registration_form" model="ir.ui.view">
        <field name="name">bxi.transport.registration.form</field>
        <field name="model">bxi.transport.registration</field>
        <field name="arch" type="xml">
            <form string="Transport Registration">
                <header>
                    <button name="action_confirm" type="object" string="Confirm &amp; Generate Invoice"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_activate" type="object" string="Activate" class="oe_highlight"
                            invisible="state != 'confirmed'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state == 'cancelled'"/>
                    <button name="action_set_draft" type="object" string="Reset to Draft"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,active"/>
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button class="oe_stat_button" type="object" name="action_view_invoice"
                                icon="fa-file-text-o" invisible="not invoice_id">
                            <field string="Invoice" name="invoice_payment_state" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="route_id"/>
                            <field name="stop_id"/>
                            <field name="academic_year_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="fee_amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="pickup_time" widget="float_time" readonly="1"/>
                            <field name="drop_time" widget="float_time" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_transport_registration_search" model="ir.ui.view">
        <field name="name">bxi.transport.registration.search</field>
        <field name="model">bxi.transport.registration</field>
        <field name="arch" type="xml">
            <search string="Transport Registrations">
                <field name="name"/>
                <field name="student_id"/>
                <field name="route_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Active" name="active_state" domain="[('state', '=', 'active')]"/>
                <group name="group_by">
                    <filter string="Route" name="group_route" context="{'group_by': 'route_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_transport_registration" model="ir.actions.act_window">
        <field name="name">Registrations</field>
        <field name="res_model">bxi.transport.registration</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_transport_registration_search"/>
    </record>
</odoo>
