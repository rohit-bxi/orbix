<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_op_student_form_transport" model="ir.ui.view">
        <field name="name">op.student.form.transport</field>
        <field name="model">op.student</field>
        <field name="inherit_id" ref="openeducat_core.view_op_student_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_transport_registrations"
                        icon="fa-bus"
                        groups="bxi_school_transport_bus_management.group_transport_staff,bxi_school_transport_bus_management.group_transport_manager">
                    <field string="Transport" name="transport_count" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
