<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- bxi.transport.registration -->
    <record id="transport_registration_rule_staff" model="ir.rule">
        <field name="name">Transport Registration: Staff/Manager see all</field>
        <field name="model_id" ref="model_bxi_transport_registration"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_transport_staff'))]"/>
    </record>

    <record id="transport_registration_rule_self" model="ir.rule">
        <field name="name">Transport Registration: Self read-only</field>
        <field name="model_id" ref="model_bxi_transport_registration"/>
        <field name="domain_force">[('student_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

    <record id="transport_registration_rule_company" model="ir.rule">
        <field name="name">Transport Registration: Multi-company</field>
        <field name="model_id" ref="model_bxi_transport_registration"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- bxi.transport.route -->
    <record id="transport_route_rule_company" model="ir.rule">
        <field name="name">Bus Route: Multi-company</field>
        <field name="model_id" ref="model_bxi_transport_route"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- bxi.transport.driver -->
    <record id="transport_driver_rule_company" model="ir.rule">
        <field name="name">Transport Driver: Multi-company</field>
        <field name="model_id" ref="model_bxi_transport_driver"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
