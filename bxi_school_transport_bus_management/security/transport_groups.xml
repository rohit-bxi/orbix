<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_transport" model="ir.module.category">
        <field name="name">Transport</field>
        <field name="sequence">27</field>
    </record>

    <record id="privilege_transport" model="res.groups.privilege">
        <field name="name">Transport</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_transport"/>
    </record>

    <record id="group_transport_staff" model="res.groups">
        <field name="name">Transport Staff</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_transport"/>
    </record>

    <record id="group_transport_manager" model="res.groups">
        <field name="name">Transport Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_transport"/>
        <field name="implied_ids" eval="[(4, ref('group_transport_staff'))]"/>
    </record>
</odoo>
