<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_bxi_faq_list" model="ir.ui.view">
        <field name="name">bxi.faq.list</field>
        <field name="model">bxi.faq</field>
        <field name="arch" type="xml">
            <list string="FAQs" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="question"/>
                <field name="category"/>
                <field name="audience"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_bxi_faq_form" model="ir.ui.view">
        <field name="name">bxi.faq.form</field>
        <field name="model">bxi.faq</field>
        <field name="arch" type="xml">
            <form string="FAQ">
                <sheet>
                    <group>
                        <field name="question"/>
                        <field name="category"/>
                        <field name="audience"/>
                        <field name="active"/>
                    </group>
                    <field name="answer"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bxi_faq" model="ir.actions.act_window">
        <field name="name">FAQs</field>
        <field name="res_model">bxi.faq</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_faq" name="FAQ" parent="bxi_api.menu_api_root" action="action_bxi_faq" sequence="40"/>
</odoo>
