<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- A teacher sees only their own documents; the office sees all. -->
    <record id="rule_faculty_document_own" model="ir.rule">
        <field name="name">Teacher Documents: own</field>
        <field name="model_id" ref="model_bxi_faculty_document"/>
        <field name="domain_force">[('faculty_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('openeducat_core.group_op_faculty'))]"/>
    </record>
    <record id="rule_faculty_document_office" model="ir.rule">
        <field name="name">Teacher Documents: office</field>
        <field name="model_id" ref="model_bxi_faculty_document"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('openeducat_core.group_op_back_office_admin'))]"/>
    </record>
</odoo>
