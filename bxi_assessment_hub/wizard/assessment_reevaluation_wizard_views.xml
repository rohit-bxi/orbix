<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_assessment_reevaluation_wizard_form" model="ir.ui.view">
        <field name="name">bxi.assessment.reevaluation.wizard.form</field>
        <field name="model">bxi.assessment.reevaluation.wizard</field>
        <field name="arch" type="xml">
            <form string="Re-evaluate Submission">
                <field name="submission_id" invisible="1"/>
                <group>
                    <group>
                        <field name="original_score" readonly="1"/>
                        <field name="max_score" readonly="1" string="Max Score"/>
                    </group>
                    <group>
                        <field name="marks_adjustment"/>
                        <field name="estimated_new_score" readonly="1"/>
                    </group>
                </group>
                <field name="reason" placeholder="Explain why this submission is being re-evaluated"/>
                <footer>
                    <button name="action_confirm" type="object" string="Save &amp; Send Feedback" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_assessment_reevaluation_wizard" model="ir.actions.act_window">
        <field name="name">Re-evaluate Submission</field>
        <field name="res_model">bxi.assessment.reevaluation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
