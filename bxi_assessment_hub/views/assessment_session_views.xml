<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_assessment_session_list" model="ir.ui.view">
        <field name="name">bxi.assessment.session.list</field>
        <field name="model">bxi.assessment.session</field>
        <field name="arch" type="xml">
            <list string="Assigned Assessments" decoration-muted="state == 'cancelled'">
                <field name="exam_id"/>
                <field name="class_id"/>
                <field name="teacher_id"/>
                <field name="exam_date"/>
                <field name="exam_time" widget="float_time"/>
                <field name="total_marks"/>
                <field name="submission_count"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'completed'"
                       decoration-info="state == 'scheduled'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_assessment_session_form" model="ir.ui.view">
        <field name="name">bxi.assessment.session.form</field>
        <field name="model">bxi.assessment.session</field>
        <field name="arch" type="xml">
            <form string="Assign Assessment">
                <header>
                    <button name="action_cancel" type="object" string="Cancel Session"
                            invisible="state != 'scheduled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="scheduled,completed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="exam_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="teacher_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="class_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        </group>
                        <group>
                            <field name="exam_date"/>
                            <field name="exam_time" widget="float_time"/>
                            <field name="total_marks"/>
                        </group>
                    </group>
                    <field name="student_ids" widget="many2many_tags"/>
                    <div class="text-muted">
                        <field name="assignment_summary" readonly="1"/>
                    </div>
                    <notebook>
                        <page string="Submissions">
                            <field name="submission_ids" readonly="1">
                                <list open_form_view="1">
                                    <field name="student_id"/>
                                    <field name="status" widget="badge"/>
                                    <field name="total_score"/>
                                    <field name="max_score"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_assessment_session" model="ir.actions.act_window">
        <field name="name">Scheduled Assessments</field>
        <field name="res_model">bxi.assessment.session</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_assessment_session_new" model="ir.actions.act_window">
        <field name="name">Assign Assessment</field>
        <field name="res_model">bxi.assessment.session</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
