<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.bxi.assessment.hub</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Assessments &amp; Exams" name="bxi_assessment_hub"
                     logo="/bxi_assessment_hub/static/description/icon.png">
                    <block title="AI Provider (Anthropic)"
                           help="Used to generate AI assignment questions and to auto-grade short/long answer submissions.">
                        <setting id="bxi_ai_api_key" string="API Key">
                            <field name="bxi_ai_api_key" password="True"/>
                        </setting>
                        <setting id="bxi_ai_model" string="Model">
                            <field name="bxi_ai_model" placeholder="claude-sonnet-5"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
