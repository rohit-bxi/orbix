<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="exam_rule_teacher_own" model="ir.rule">
        <field name="name">Digital Exam: Teacher sees own</field>
        <field name="model_id" ref="model_bxi_exam"/>
        <field name="domain_force">[('teacher_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('openeducat_core.group_op_faculty'))]"/>
    </record>

