<odoo>
    <record id="parent_face_capture" model="ir.ui.view">
        <field name="name">op.parent.face.capture</field>
        <field name="model">op.parent</field>
        <field name="inherit_id" ref="openeducat_parent.view_op_parent_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_employee_avatar')]/field[@name='name']" position="after">
                <button name="open_image_capture" type="object" id="parent_image_capture_button" class="oe_highlight" string="CLICK IMAGE"/>
            </xpath>
        </field>
    </record>
</odoo>
