<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_uniform" model="ir.module.category">
        <field name="name">Uniform</field>
        <field name="sequence">27</field>
    </record>

    <record id="privilege_uniform" model="res.groups.privilege">
        <field name="name">Uniform</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_uniform"/>
    </record>

    <record id="group_uniform_staff" model="res.groups">
        <field name="name">Uniform Staff</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_uniform"/>
    </record>

    <record id="group_uniform_manager" model="res.groups">
        <field name="name">Uniform Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_uniform"/>
        <field name="implied_ids" eval="[(4, ref('group_uniform_staff'))]"/>
    </record>
</odoo>
