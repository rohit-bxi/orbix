<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- bxi.uniform.order -->
    <record id="uniform_order_rule_staff" model="ir.rule">
        <field name="name">Uniform Order: Staff/Manager see all</field>
        <field name="model_id" ref="model_bxi_uniform_order"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_uniform_staff'))]"/>
    </record>

    <record id="uniform_order_rule_self" model="ir.rule">
        <field name="name">Uniform Order: Self read-only</field>
        <field name="model_id" ref="model_bxi_uniform_order"/>
        <field name="domain_force">['|', ('student_id.user_id', '=', user.id), ('faculty_id.partner_id.user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

    <record id="uniform_order_rule_company" model="ir.rule">
        <field name="name">Uniform Order: Multi-company</field>
        <field name="model_id" ref="model_bxi_uniform_order"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- bxi.uniform.order.line -->
    <record id="uniform_order_line_rule_staff" model="ir.rule">
        <field name="name">Uniform Order Line: Staff/Manager see all</field>
        <field name="model_id" ref="model_bxi_uniform_order_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_uniform_staff'))]"/>
    </record>

    <record id="uniform_order_line_rule_self" model="ir.rule">
        <field name="name">Uniform Order Line: Self read-only</field>
        <field name="model_id" ref="model_bxi_uniform_order_line"/>
        <field name="domain_force">['|', ('order_id.student_id.user_id', '=', user.id), ('order_id.faculty_id.partner_id.user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

    <!-- bxi.uniform.stock -->
    <record id="uniform_stock_rule_company" model="ir.rule">
        <field name="name">Uniform Stock: Multi-company</field>
        <field name="model_id" ref="model_bxi_uniform_stock"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
