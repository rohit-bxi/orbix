<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_generate_today_sessions" model="ir.cron">
            <field name="name">Student Attendance: Generate Today's Timetable Sessions</field>
            <field name="model_id" ref="openeducat_timetable.model_op_session"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_today_sessions()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(datetime.utcnow().replace(hour=0, minute=15, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
    </data>
</odoo>
