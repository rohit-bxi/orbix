<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_attendance_student_list" model="ir.ui.view">
        <field name="name">hr.attendance.student.list</field>
        <field name="model">hr.attendance</field>
        <field name="arch" type="xml">
            <list string="Student Attendance" default_order="check_in desc">
                <field name="student_id"/>
                <field name="class_id"/>
                <field name="section_id"/>
                <field name="session_id"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="date"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'present'"
                       decoration-danger="status == 'absent'"
                       decoration-warning="status == 'late'"
                       decoration-info="status == 'excused'"/>
                <field name="remark"/>
            </list>
        </field>
    </record>

    <record id="view_hr_attendance_student_form" model="ir.ui.view">
        <field name="name">hr.attendance.student.form</field>
        <field name="model">hr.attendance</field>
        <field name="arch" type="xml">
            <form string="Student Attendance">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id" string="Student"
                                   domain="[('student_id', '!=', False)]"/>
                            <field name="class_id" readonly="1"/>
                            <field name="section_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="session_id"/>
                            <field name="check_in"/>
                            <field name="check_out"/>
                            <field name="status"/>
                        </group>
                    </group>
                    <group string="Comments">
                        <field name="remark" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hr_attendance_student_search" model="ir.ui.view">
        <field name="name">hr.attendance.student.search</field>
        <field name="model">hr.attendance</field>
        <field name="arch" type="xml">
            <search string="Student Attendance">
                <field name="student_id" string="Student"/>
                <field name="class_id" string="Class"/>
                <field name="section_id" string="Section"/>
                <field name="date" string="Date"/>
                <filter string="Today" name="filter_attendance_today"
                        domain="[('date', '=', context_today())]"/>
                <filter string="This Week" name="filter_attendance_week"
                        domain="[('date', '&gt;=', (context_today()+relativedelta(weeks=-1,days=1,weekday=0)).strftime('%Y-%m-%d')),
                                 ('date', '&lt;=', (context_today()-relativedelta(weekday=6)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Present" name="filter_status_present" domain="[('status', '=', 'present')]"/>
                <filter string="Absent" name="filter_status_absent" domain="[('status', '=', 'absent')]"/>
                <filter string="Late" name="filter_status_late" domain="[('status', '=', 'late')]"/>
                <filter string="Excused" name="filter_status_excused" domain="[('status', '=', 'excused')]"/>
                <group>
                    <filter string="Student" name="group_by_student" domain="[]" context="{'group_by': 'student_id'}"/>
                    <filter string="Class" name="group_by_class" domain="[]" context="{'group_by': 'class_id'}"/>
                    <filter string="Section" name="group_by_section" domain="[]" context="{'group_by': 'section_id'}"/>
                    <filter string="Date" name="group_by_date" domain="[]" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_student_attendance" model="ir.actions.act_window">
        <field name="name">Student Attendance</field>
        <field name="res_model">hr.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('student_id', '!=', False)]</field>
        <field name="context">{'search_default_filter_attendance_today': 1}</field>
        <field name="search_view_id" ref="view_hr_attendance_student_search"/>
    </record>

    <record model="ir.actions.act_window.view" id="action_student_attendance_view_list">
        <field name="act_window_id" ref="action_student_attendance"/>
        <field name="sequence" eval="10"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_hr_attendance_student_list"/>
    </record>

    <record model="ir.actions.act_window.view" id="action_student_attendance_view_form">
        <field name="act_window_id" ref="action_student_attendance"/>
        <field name="sequence" eval="20"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_hr_attendance_student_form"/>
    </record>
</odoo>
