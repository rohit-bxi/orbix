<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_announcement_list" model="ir.ui.view">
        <field name="name">bxi.announcement.list</field>
        <field name="model">bxi.announcement</field>
        <field name="arch" type="xml">
            <list string="Announcements" decoration-muted="state == 'archived'">
                <field name="title"/>
                <field name="category" widget="badge"/>
                <field name="priority" widget="badge"
                       decoration-danger="priority == 'urgent'"
                       decoration-warning="priority == 'high'"
                       decoration-muted="priority == 'low'"/>
                <field name="target_audience"/>
                <field name="recipient_count" string="Recipients"/>
                <field name="published_date"/>
                <field name="author_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'published'"
                       decoration-info="state == 'scheduled'"
                       decoration-muted="state in ('draft', 'archived')"/>
            </list>
        </field>
    </record>

    <record id="view_announcement_form" model="ir.ui.view">
        <field name="name">bxi.announcement.form</field>
        <field name="model">bxi.announcement</field>
        <field name="arch" type="xml">
            <form string="Announcement">
                <header>
                    <button name="action_publish" type="object" string="Publish" class="oe_highlight"
                            invisible="state not in ('draft', 'scheduled')"/>
                    <button name="action_archive_announcement" type="object" string="Archive"
                            invisible="state != 'published'"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state not in ('scheduled', 'archived')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,scheduled,published"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="title"/>
                        <h1><field name="title" placeholder="e.g. Annual Sports Day — June 20"/></h1>
                        <field name="name" readonly="1" class="text-muted"/>
                    </div>
                    <group>
                        <group>
                            <field name="category"/>
                            <field name="priority"/>
                        </group>
                        <group>
                            <field name="recipient_count" readonly="1"/>
                            <field name="published_date" readonly="1" invisible="not published_date"/>
                            <field name="author_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="body" placeholder="Write the announcement message..."/>
                    </group>
                    <group string="Target Audience">
                        <group>
                            <field name="target_audience"/>
                        </group>
                        <group invisible="target_audience != 'specific_class'">
                            <field name="course_ids" widget="many2many_tags" string="Classes"/>
                            <field name="batch_ids" widget="many2many_tags" string="Sections"/>
                        </group>
                    </group>
                    <group string="Delivery Channels">
                        <group>
                            <field name="channel_in_app"/>
                            <field name="channel_email"/>
                        </group>
                        <group>
                            <field name="channel_sms"/>
                            <field name="channel_push"/>
                        </group>
                    </group>
                    <group string="Schedule (optional)">
                        <field name="schedule_date" string="Schedule"
                               help="Leave empty to send immediately"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_announcement_search" model="ir.ui.view">
        <field name="name">bxi.announcement.search</field>
        <field name="model">bxi.announcement</field>
        <field name="arch" type="xml">
            <search string="Announcements">
                <field name="title"/>
                <field name="category"/>
                <field name="target_audience"/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Scheduled" name="filter_scheduled" domain="[('state', '=', 'scheduled')]"/>
                <filter string="Published" name="filter_published" domain="[('state', '=', 'published')]"/>
                <filter string="Archived" name="filter_archived" domain="[('state', '=', 'archived')]"/>
                <separator/>
                <filter string="Category" name="group_category" context="{'group_by': 'category'}"/>
                <filter string="Priority" name="group_priority" context="{'group_by': 'priority'}"/>
                <filter string="Status" name="group_status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_announcement" model="ir.actions.act_window">
        <field name="name">Announcements</field>
        <field name="res_model">bxi.announcement</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_announcement_search"/>
        <field name="context">{'search_default_filter_published': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an announcement to notify students, teachers or parents</p>
        </field>
    </record>
</odoo>
