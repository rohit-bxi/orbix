<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_announcement" model="ir.module.category">
        <field name="name">Announcements</field>
        <field name="sequence">29</field>
    </record>

    <record id="privilege_announcement" model="res.groups.privilege">
        <field name="name">Announcements</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_announcement"/>
    </record>

    <record id="group_announcement_manager" model="res.groups">
        <field name="name">Announcement Manager</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_announcement"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
