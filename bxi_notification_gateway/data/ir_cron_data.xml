<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_send_push_notifications" model="ir.cron">
        <field name="name">Orbix: Send Pending Push Notifications</field>
        <field name="model_id" ref="model_bxi_notification"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_pending_push()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
