<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_op_parent_form_event" model="ir.ui.view">
        <field name="name">op.parent.form.event</field>
        <field name="model">op.parent</field>
        <field name="inherit_id" ref="openeducat_parent.view_op_parent_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_child_event_registrations" icon="fa-calendar">
                    <field string="Events" name="child_event_registration_count" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
