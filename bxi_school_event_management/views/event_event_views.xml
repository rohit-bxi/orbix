<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_event_form_school" model="ir.ui.view">
        <field name="name">event.event.form.school</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='stage_id']" position="before">
                <button name="action_open_bulk_registration_wizard" type="object" string="Bulk Register"
                        groups="event.group_event_user"/>
                <button name="action_open_certificate_wizard" type="object" string="Generate Certificates"
                        groups="bxi_school_event_management.group_school_event_coordinator"/>
                <button name="action_post_announcement" type="object" string="Announce"
                        groups="event.group_event_user"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <div class="alert alert-warning" role="alert" invisible="not over_capacity">
                    The selected venue's capacity is lower than the maximum registrations for this event.
                </div>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="School" name="school">
                    <group>
                        <group string="Classification">
                            <field name="event_category"/>
                            <field name="venue_id"/>
                            <field name="over_capacity" invisible="1"/>
                            <field name="academic_year_id"/>
                            <field name="academic_term_id" domain="[('academic_year_id', '=', academic_year_id)]"/>
                            <field name="coordinator_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Audience">
                            <field name="target_audience"/>
                            <field name="course_ids" widget="many2many_tags" invisible="target_audience != 'specific_class'"/>
                            <field name="batch_ids" widget="many2many_tags" invisible="target_audience != 'specific_class'"/>
                        </group>
                    </group>
                    <group string="Fees &amp; Logistics">
                        <group>
                            <field name="is_paid_event"/>
                            <field name="fee_product_id" invisible="not is_paid_event" required="is_paid_event"/>
                        </group>
                        <group>
                            <field name="requires_permission_slip"/>
                            <field name="requires_transport"/>
                        </group>
                    </group>
                    <group string="Announcement" invisible="not announcement_id">
                        <field name="announcement_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_event_search_school" model="ir.ui.view">
        <field name="name">event.event.search.school</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='event_type_id']" position="after">
                <field name="event_category"/>
                <field name="venue_id"/>
            </xpath>
            <xpath expr="//filter[@name='venue']" position="after">
                <filter string="Category" name="group_event_category" context="{'group_by': 'event_category'}"/>
            </xpath>
        </field>
    </record>
</odoo>
