<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_op_student_form_event" model="ir.ui.view">
        <field name="name">op.student.form.event</field>
        <field name="model">op.student</field>
        <field name="inherit_id" ref="openeducat_core.view_op_student_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_event_registrations" icon="fa-calendar"
                        groups="event.group_event_registration_desk">
                    <field string="Events" name="event_registration_count" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
