<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_event_venue_list" model="ir.ui.view">
        <field name="name">bxi.event.venue.list</field>
        <field name="model">bxi.event.venue</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="building"/>
                <field name="capacity"/>
                <field name="event_count"/>
            </list>
        </field>
    </record>

    <record id="view_event_venue_form" model="ir.ui.view">
        <field name="name">bxi.event.venue.form</field>
        <field name="model">bxi.event.venue</field>
        <field name="arch" type="xml">
            <form string="Venue">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_events" icon="fa-calendar">
                            <field string="Events" name="event_count" widget="statinfo"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="building"/>
                        <field name="capacity"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_event_venue" model="ir.actions.act_window">
        <field name="name">Venues</field>
        <field name="res_model">bxi.event.venue</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
