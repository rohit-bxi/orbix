<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="event_registration_rule_portal" model="ir.rule">
        <field name="name">Event Registration: Portal user sees own / children's only</field>
        <field name="model_id" ref="event.model_event_registration"/>
        <field name="domain_force">['|', ('student_id.user_id', '=', user.id), ('student_id.user_id', 'in', user.child_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
</odoo>
