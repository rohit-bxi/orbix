<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_refund_bulk_wizard_form" model="ir.ui.view">
        <field name="name">bxi.refund.bulk.wizard.form</field>
        <field name="model">bxi.refund.bulk.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Refund Processing">
                <group>
                    <group>
                        <field name="total_students_with_excess" readonly="1"/>
                        <field name="selected_count" readonly="1"/>
                    </group>
                    <group>
                        <field name="total_refund_amount" readonly="1"/>
                        <field name="available_for_refund" readonly="1"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </group>
                <group string="Select Students">
                    <field name="class_id"/>
                    <field name="section_id"/>
                    <field name="student_ids" widget="many2many_tags"
                           domain="[('course_detail_ids.course_id', '=', class_id)] if class_id else []"/>
                </group>
                <group string="Refund Details (Applied to All Selected)">
                    <group>
                        <field name="refund_type"/>
                        <field name="refund_amount_calculation"/>
                        <field name="refund_percentage" invisible="refund_amount_calculation != 'percentage_of_excess'"/>
                        <field name="fixed_refund_amount" invisible="refund_amount_calculation != 'fixed_amount'"/>
                    </group>
                    <group>
                        <field name="priority"/>
                        <field name="request_date"/>
                    </group>
                </group>
                <group>
                    <field name="reason"/>
                </group>
                <group string="Refund Method (Common for All)">
                    <field name="preferred_refund_mode"/>
                    <field name="processing_status"/>
                </group>
                <group string="Supporting Documents (Common for All)">
                    <field name="document_ids" widget="many2many_binary"/>
                </group>
                <group string="Notification Settings">
                    <field name="notify_parent"/>
                    <field name="notify_sms"/>
                    <field name="notify_email"/>
                    <field name="notify_auto_update"/>
                </group>
                <footer>
                    <button name="action_process_refunds" type="object" string="Process Refunds" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_refund_bulk_wizard" model="ir.actions.act_window">
        <field name="name">Bulk Refund Processing</field>
        <field name="res_model">bxi.refund.bulk.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
