<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_refund" model="ir.module.category">
        <field name="name">Refund</field>
        <field name="sequence">29</field>
    </record>

    <record id="privilege_refund" model="res.groups.privilege">
        <field name="name">Refund</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_refund"/>
    </record>

    <record id="group_refund_staff" model="res.groups">
        <field name="name">Refund Staff</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_refund"/>
    </record>

    <record id="group_refund_manager" model="res.groups">
        <field name="name">Refund Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_refund"/>
        <field name="implied_ids" eval="[(4, ref('group_refund_staff'))]"/>
    </record>
</odoo>
