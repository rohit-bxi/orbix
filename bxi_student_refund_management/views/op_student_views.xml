<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_op_student_form_refund" model="ir.ui.view">
        <field name="name">op.student.form.refund</field>
        <field name="model">op.student</field>
        <field name="inherit_id" ref="openeducat_core.view_op_student_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_refund_requests" icon="fa-undo"
                        groups="bxi_student_refund_management.group_refund_staff,bxi_student_refund_management.group_refund_manager">
                    <field string="Refund Requests" name="refund_request_count" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
