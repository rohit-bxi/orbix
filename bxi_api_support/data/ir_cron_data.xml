<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_fee_due_reminders" model="ir.cron">
        <field name="name">Orbix: Fee Due Reminders (app)</field>
        <field name="model_id" ref="openeducat_fees.model_op_student_fees_details"/>
        <field name="state">code</field>
        <field name="code">model._cron_bxi_fee_due_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
