<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_slide_slide_form_bxi_reader" model="ir.ui.view">
        <field name="name">slide.slide.form.bxi.reader</field>
        <field name="model">slide.slide</field>
        <field name="inherit_id" ref="website_slides.view_slide_slide_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='description']" position="after">
                <page name="bxi_reader" string="App Reader">
                    <group>
                        <group string="Chapter">
                            <field name="bxi_level"/>
                            <field name="bxi_read_minutes"/>
                        </group>
                        <group string="Listen / Watch">
                            <field name="bxi_audio" filename="bxi_audio_filename"/>
                            <field name="bxi_audio_filename" invisible="1"/>
                            <field name="bxi_video_url" widget="url"/>
                        </group>
                    </group>
                    <field name="bxi_learning_objectives" placeholder="One learning objective per line"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
