<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_face_login" model="ir.module.category">
        <field name="name">Face Login</field>
        <field name="sequence">31</field>
    </record>

    <record id="privilege_face_login" model="res.groups.privilege">
        <field name="name">Face Login</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_face_login"/>
    </record>

    <record id="group_face_manager" model="res.groups">
        <field name="name">Face Login Manager</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_face_login"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Reviews face login enrolments, enrols people in person, manages kiosks and settings (through the Orbix admin API).</field>
    </record>
</odoo>
