<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Face Recognition on the Account & Security tab of the Student,
         Teacher and Parent forms (bxi_api_support). -->
    <record id="view_op_student_form_face_recognition" model="ir.ui.view">
        <field name="name">op.student.form.face.recognition</field>
        <field name="model">op.student</field>
        <field name="inherit_id" ref="bxi_api_support.view_op_student_form_account_security"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='bxi_login']" position="after">
                        <group string="Face Recognition" name="bxi_face">
                            <field name="bxi_face_state" widget="badge"
                                   decoration-success="bxi_face_state == 'active'"
                                   decoration-warning="bxi_face_state == 'pending'"
                                   decoration-danger="bxi_face_state in ('rejected', 'expired')"/>
                            <field name="bxi_face_enrolled_at" invisible="not bxi_face_enrolled_at"/>
                            <field name="bxi_face_expires_at" invisible="not bxi_face_expires_at"/>
                            <field name="bxi_face_problem" invisible="not bxi_face_problem"/>
                        </group>
            </xpath>
            <xpath expr="//div[@name='bxi_account_buttons']" position="inside">
                    <button name="action_bxi_face_enable" type="object" string="Enable Face Recognition"
                            class="btn-secondary" icon="fa-smile-o"
                            invisible="not bxi_has_login or bxi_face_state == 'active'"/>
                    <button name="action_bxi_face_enable" type="object" string="Update Face Photo"
                            class="btn-secondary" icon="fa-camera"
                            invisible="bxi_face_state != 'active'"/>
                    <button name="action_bxi_face_disable" type="object" string="Disable Face Recognition"
                            class="btn-secondary" icon="fa-ban" invisible="bxi_face_state not in ('active', 'pending')"
                            confirm="Face sign-in and face attendance stop for this person. Continue?"/>
            </xpath>
        </field>
    </record>

