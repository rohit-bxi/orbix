    <record id="view_bxi_face_enable_wizard_form" model="ir.ui.view">
        <field name="name">bxi.face.enable.wizard.form</field>
        <field name="model">bxi.face.enable.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="res_model" invisible="1"/>
                <field name="res_id" invisible="1"/>
                <group>
                    <field name="image" widget="image" options="{'size': [180, 180]}"/>
                    <field name="consent_reference" invisible="res_model != 'op.student'"/>
                </group>
                <div class="text-muted">
                    Upload the person's latest photo: one face, looking straight at the camera, well lit.
                    It becomes their face for face sign-in and face attendance.
                </div>
                <footer>
                    <button name="action_apply" type="object" string="Enable" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
