<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A teacher edits and deletes their own study notes; everyone with
         access reads all. Coordinators, managers and the office are not
         restricted (no rule for their groups). -->
    <record id="rule_study_note_teacher_own" model="ir.rule">
        <field name="name">Study Note: teacher edits own notes</field>
        <field name="model_id" ref="model_bxi_study_note"/>
        <field name="groups" eval="[(4, ref('openeducat_core.group_op_faculty'))]"/>
        <field name="domain_force">[('faculty_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_study_note_coordinator_all" model="ir.rule">
        <field name="name">Study Note: coordinators, managers and office edit all</field>
        <field name="model_id" ref="model_bxi_study_note"/>
        <field name="groups" eval="[(4, ref('bxi_academic_management.group_academic_coordinator')),
                                    (4, ref('bxi_academic_management.group_academic_manager')),
                                    (4, ref('openeducat_core.group_op_back_office_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="False"/>
    </record>

    <!-- A teacher sees and answers the doubts assigned to them. -->
    <record id="rule_student_doubt_teacher_own" model="ir.rule">
        <field name="name">Student Doubt: teacher's own</field>
        <field name="model_id" ref="model_bxi_student_doubt"/>
        <field name="groups" eval="[(4, ref('openeducat_core.group_op_faculty'))]"/>
        <field name="domain_force">[('teacher_id.user_id', '=', user.id)]</field>
    </record>

    <record id="rule_student_doubt_coordinator_all" model="ir.rule">
        <field name="name">Student Doubt: coordinators, managers and office see all</field>
        <field name="model_id" ref="model_bxi_student_doubt"/>
        <field name="groups" eval="[(4, ref('bxi_academic_management.group_academic_coordinator')),
                                    (4, ref('bxi_academic_management.group_academic_manager')),
                                    (4, ref('openeducat_core.group_op_back_office_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
