<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_student_doubt_list" model="ir.ui.view">
        <field name="name">bxi.student.doubt.list</field>
        <field name="model">bxi.student.doubt</field>
        <field name="arch" type="xml">
            <list string="Student Doubts">
                <field name="create_date" string="Asked On"/>
                <field name="student_id"/>
                <field name="subject_id"/>
                <field name="question"/>
                <field name="teacher_id"/>
                <field name="state" widget="badge" decoration-warning="state == 'open'"
                       decoration-success="state == 'answered'"/>
            </list>
        </field>
    </record>

    <record id="view_student_doubt_form" model="ir.ui.view">
        <field name="name">bxi.student.doubt.form</field>
        <field name="model">bxi.student.doubt</field>
        <field name="arch" type="xml">
            <form string="Student Doubt">
                <header>
                    <button name="action_close" type="object" string="Close" invisible="state == 'closed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="student_id" readonly="1"/>
                            <field name="subject_id"/>
                            <field name="course_id" readonly="1"/>
                            <field name="batch_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="teacher_id"/>
                            <field name="answered_by_id"/>
                            <field name="answered_at"/>
                        </group>
                    </group>
                    <label for="question"/>
                    <field name="question" readonly="1"/>
                    <field name="attachment_ids" widget="many2many_binary" readonly="1"/>
                    <label for="answer"/>
                    <field name="answer" placeholder="Answer the student here (or from the app)."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_student_doubt_search" model="ir.ui.view">
        <field name="name">bxi.student.doubt.search</field>
        <field name="model">bxi.student.doubt</field>
        <field name="arch" type="xml">
            <search string="Student Doubts">
                <field name="question"/>
                <field name="student_id"/>
                <field name="subject_id"/>
                <field name="teacher_id"/>
                <filter string="Open" name="open" domain="[('state', '=', 'open')]"/>
                <filter string="Answered" name="answered" domain="[('state', '=', 'answered')]"/>
            </search>
        </field>
    </record>

    <record id="action_student_doubt" model="ir.actions.act_window">
        <field name="name">Student Doubts</field>
        <field name="res_model">bxi.student.doubt</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_student_doubt_search"/>
        <field name="context">{'search_default_open': 1}</field>
    </record>
</odoo>
