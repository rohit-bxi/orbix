<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_study_note_list" model="ir.ui.view">
        <field name="name">bxi.study.note.list</field>
        <field name="model">bxi.study.note</field>
        <field name="arch" type="xml">
            <list string="Study Notes">
                <field name="name"/>
                <field name="subject_id"/>
                <field name="course_id"/>
                <field name="batch_ids" widget="many2many_tags" optional="hide"/>
                <field name="faculty_id"/>
                <field name="chapter" optional="show"/>
                <field name="priority" widget="badge" decoration-danger="priority == 'high'"/>
                <field name="publish_date"/>
                <field name="state" widget="badge" decoration-success="state == 'published'"/>
            </list>
        </field>
    </record>

    <record id="view_study_note_form" model="ir.ui.view">
        <field name="name">bxi.study.note.form</field>
        <field name="model">bxi.study.note</field>
        <field name="arch" type="xml">
            <form string="Study Note">
                <header>
                    <button name="action_publish" type="object" string="Publish" class="btn-primary"
                            invisible="state == 'published'"/>
                    <button name="action_unpublish" type="object" string="Back to Draft"
                            invisible="state != 'published'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g., Quadratic Equations"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="subject_id" options="{'no_create': True}"/>
                            <field name="course_id" options="{'no_create': True}"/>
                            <field name="batch_ids" widget="many2many_tags" options="{'no_create': True}"
                                   domain="[('course_id', '=', course_id)]"/>
                            <field name="faculty_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="chapter"/>
                            <field name="priority"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                            <field name="publish_date"/>
                            <field name="read_minutes"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Content" name="content">
                            <field name="summary" placeholder="Short description shown on the note card"/>
                            <field name="key_points" placeholder="Key points, one per line"/>
                            <field name="content"/>
                        </page>
                        <page string="Attachments" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Comments" name="comments">
                            <field name="comment_ids">
                                <list editable="bottom">
                                    <field name="author_id"/>
                                    <field name="body"/>
                                    <field name="create_date"/>
                                    <field name="hidden"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_study_note_search" model="ir.ui.view">
        <field name="name">bxi.study.note.search</field>
        <field name="model">bxi.study.note</field>
        <field name="arch" type="xml">
            <search string="Study Notes">
                <field name="name"/>
                <field name="subject_id"/>
                <field name="course_id"/>
                <field name="faculty_id"/>
                <filter string="Published" name="published" domain="[('state', '=', 'published')]"/>
                <filter string="High Priority" name="high" domain="[('priority', '=', 'high')]"/>
                <group name="group_by">
                    <filter string="Subject" name="group_subject" context="{'group_by': 'subject_id'}"/>
                    <filter string="Class" name="group_class" context="{'group_by': 'course_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_study_note" model="ir.actions.act_window">
        <field name="name">Study Notes</field>
        <field name="res_model">bxi.study.note</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_study_note_search"/>
    </record>

    <record id="action_study_note_tag" model="ir.actions.act_window">
        <field name="name">Note Tags</field>
        <field name="res_model">bxi.study.note.tag</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_study_note_tag_list" model="ir.ui.view">
        <field name="name">bxi.study.note.tag.list</field>
        <field name="model">bxi.study.note.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>
</odoo>
