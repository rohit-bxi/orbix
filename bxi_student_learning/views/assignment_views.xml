<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The app's Task Details: chapter, difficulty, objectives, requirements. -->
    <record id="view_op_assignment_form_bxi_details" model="ir.ui.view">
        <field name="name">op.assignment.form.bxi.details</field>
        <field name="model">op.assignment</field>
        <field name="inherit_id" ref="openeducat_assignment.view_op_assignment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='basic_information']" position="after">
                <page name="bxi_task_details" string="Task Details">
                    <group>
                        <group>
                            <field name="bxi_chapter"/>
                            <field name="bxi_difficulty"/>
                            <field name="point" string="Points"/>
                        </group>
                    </group>
                    <label for="bxi_learning_objectives"/>
                    <field name="bxi_learning_objectives" placeholder="One objective per line"/>
                    <label for="bxi_requirements"/>
                    <field name="bxi_requirements" placeholder="One requirement per line"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
