<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ELEARNING.SECTION -->
    <record id="elearning_section_view_list" model="ir.ui.view">
        <field name="name">elearning.section.view.list</field>
        <field name="model">elearning.section</field>
        <field name="arch" type="xml">
            <list string="Sections">
                <field name="sequence" widget="handle"/>
                <field name="class_id"/>
                <field name="name"/>
                <field name="channel_count"/>
                <field name="website_published"/>
            </list>
        </field>
    </record>

    <record id="elearning_section_view_form" model="ir.ui.view">
        <field name="name">elearning.section.view.form</field>
        <field name="model">elearning.section</field>
        <field name="arch" type="xml">
            <form string="Section">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="class_id"/>
                        <field name="name" placeholder="e.g. Section A"/>
                        <field name="sequence"/>
                        <field name="active" invisible="1"/>
                        <field name="website_published"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="elearning_section_view_search" model="ir.ui.view">
        <field name="name">elearning.section.view.search</field>
        <field name="model">elearning.section</field>
        <field name="arch" type="xml">
            <search string="Sections">
                <field name="name"/>
                <field name="class_id"/>
                <group>
                    <filter string="Class" name="groupby_class" context="{'group_by': 'class_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="elearning_section_action" model="ir.actions.act_window">
        <field name="name">Sections</field>
        <field name="res_model">elearning.section</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_groupby_class': 1}</field>
    </record>

    <!-- ELEARNING.CLASS -->
    <record id="elearning_class_view_list" model="ir.ui.view">
        <field name="name">elearning.class.view.list</field>
        <field name="model">elearning.class</field>
        <field name="arch" type="xml">
            <list string="Classes">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="section_count"/>
                <field name="channel_count"/>
                <field name="website_published"/>
            </list>
        </field>
    </record>

    <record id="elearning_class_view_form" model="ir.ui.view">
        <field name="name">elearning.class.view.form</field>
        <field name="model">elearning.class</field>
        <field name="arch" type="xml">
            <form string="Class">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" name="%(elearning_section_action)d" type="action" icon="fa-list">
                            <field name="section_count" widget="statinfo" string="Sections"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="name" placeholder="e.g. Class 10"/>
                        <field name="sequence"/>
                        <field name="active" invisible="1"/>
                        <field name="website_published"/>
                    </group>
                    <notebook>
                        <page string="Sections" name="sections">
                            <field name="section_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="website_published"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="elearning_class_action" model="ir.actions.act_window">
        <field name="name">Classes</field>
        <field name="res_model">elearning.class</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- MENUS -->
    <menuitem id="elearning_class_section_menu_root"
        name="Class &amp; Section"
        parent="website_slides.website_slides_menu_configuration"
        sequence="60"/>
    <menuitem id="elearning_class_menu" name="Classes"
        parent="elearning_class_section_menu_root"
        action="elearning_class_action" sequence="10"/>
    <menuitem id="elearning_section_menu" name="Sections"
        parent="elearning_class_section_menu_root"
        action="elearning_section_action" sequence="20"/>
</odoo>
