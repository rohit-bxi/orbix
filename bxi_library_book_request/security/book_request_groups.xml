<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_book_request" model="ir.module.category">
        <field name="name">Library Book Requests</field>
        <field name="sequence">32</field>
    </record>

    <record id="privilege_book_request" model="res.groups.privilege">
        <field name="name">Library Book Requests</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_book_request"/>
    </record>

    <record id="group_book_request_librarian" model="res.groups">
        <field name="name">Librarian (Approve Requests)</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_book_request"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
