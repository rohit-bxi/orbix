<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_bxi_book_request_list" model="ir.ui.view">
        <field name="name">bxi.library.book.request.list</field>
        <field name="model">bxi.library.book.request</field>
        <field name="arch" type="xml">
            <list string="Book Requests" decoration-muted="status == 'rejected'">
                <field name="name"/>
                <field name="requester_user_id"/>
                <field name="media_id"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'approved'"
                       decoration-warning="status == 'pending'"
                       decoration-danger="status == 'rejected'"/>
                <field name="create_date"/>
                <button name="action_approve" type="object" string="Approve" icon="fa-check"
                        invisible="status != 'pending'" groups="bxi_library_book_request.group_book_request_librarian"/>
                <button name="action_reject" type="object" string="Reject" icon="fa-times"
                        invisible="status != 'pending'" groups="bxi_library_book_request.group_book_request_librarian"/>
            </list>
        </field>
    </record>

    <record id="view_bxi_book_request_form" model="ir.ui.view">
        <field name="name">bxi.library.book.request.form</field>
        <field name="model">bxi.library.book.request</field>
        <field name="arch" type="xml">
            <form string="Book Request">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="oe_highlight"
                            invisible="status != 'pending'" groups="bxi_library_book_request.group_book_request_librarian"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="status != 'pending'" groups="bxi_library_book_request.group_book_request_librarian"/>
                    <field name="status" widget="statusbar" statusbar_visible="pending,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Request ID"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="requester_user_id" readonly="1"/>
                            <field name="teacher_id" readonly="status != 'pending'"/>
                            <field name="media_id" readonly="status != 'pending'"/>
                        </group>
                        <group>
                            <field name="reviewed_by" readonly="1"/>
                            <field name="reviewed_at" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason" readonly="status != 'pending'"/>
                        <field name="review_notes" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_bxi_book_request" model="ir.actions.act_window">
        <field name="name">Book Requests</field>
        <field name="res_model">bxi.library.book.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_book_request" name="Book Requests" parent="bxi_api.menu_api_root" action="action_bxi_book_request" sequence="50"
              groups="bxi_library_book_request.group_book_request_librarian"/>
</odoo>
