<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- op.health.visit -->
    <record id="health_visit_rule_staff" model="ir.rule">
        <field name="name">Health Visit: Health Staff/Manager see all</field>
        <field name="model_id" ref="model_op_health_visit"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_health_staff'))]"/>
    </record>

    <record id="health_visit_rule_faculty" model="ir.rule">
        <field name="name">Health Visit: Faculty see all (read/create only, enforced by ACL)</field>
        <field name="model_id" ref="model_op_health_visit"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('openeducat_core.group_op_faculty'))]"/>
    </record>

    <record id="health_visit_rule_back_office" model="ir.rule">
        <field name="name">Health Visit: Back Office Admin see all (read-only, enforced by ACL)</field>
        <field name="model_id" ref="model_op_health_visit"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('openeducat_core.group_op_back_office_admin'))]"/>
    </record>

    <record id="health_visit_rule_company" model="ir.rule">
        <field name="name">Health Visit: Multi-company</field>
        <field name="model_id" ref="model_op_health_visit"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- op.health.vaccination -->
    <record id="health_vaccination_rule_staff" model="ir.rule">
        <field name="name">Health Vaccination: Health Staff/Manager see all</field>
        <field name="model_id" ref="model_op_health_vaccination"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_health_staff'))]"/>
    </record>

    <record id="health_vaccination_rule_back_office" model="ir.rule">
        <field name="name">Health Vaccination: Back Office Admin see all (read-only, enforced by ACL)</field>
        <field name="model_id" ref="model_op_health_vaccination"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('openeducat_core.group_op_back_office_admin'))]"/>
    </record>

    <record id="health_vaccination_rule_company" model="ir.rule">
        <field name="name">Health Vaccination: Multi-company</field>
        <field name="model_id" ref="model_op_health_vaccination"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- op.health.checkup -->
    <record id="health_checkup_rule_staff" model="ir.rule">
        <field name="name">Health Checkup: Health Staff/Manager see all</field>
        <field name="model_id" ref="model_op_health_checkup"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_health_staff'))]"/>
    </record>

    <record id="health_checkup_rule_back_office" model="ir.rule">
        <field name="name">Health Checkup: Back Office Admin see all (read-only, enforced by ACL)</field>
        <field name="model_id" ref="model_op_health_checkup"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('openeducat_core.group_op_back_office_admin'))]"/>
    </record>

    <record id="health_checkup_rule_company" model="ir.rule">
        <field name="name">Health Checkup: Multi-company</field>
        <field name="model_id" ref="model_op_health_checkup"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
