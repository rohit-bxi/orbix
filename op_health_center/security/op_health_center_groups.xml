<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_health_center" model="ir.module.category">
        <field name="name">Health Center</field>
        <field name="sequence">25</field>
    </record>

    <record id="privilege_health_center" model="res.groups.privilege">
        <field name="name">Health Center</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_health_center"/>
    </record>

    <record id="group_health_staff" model="res.groups">
        <field name="name">Health Staff</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_health_center"/>
    </record>

    <record id="group_health_manager" model="res.groups">
        <field name="name">Health Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_health_center"/>
        <field name="implied_ids" eval="[(4, ref('group_health_staff'))]"/>
    </record>
</odoo>
