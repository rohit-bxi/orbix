<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_health_visit_report_wizard_form" model="ir.ui.view">
        <field name="name">op.health.visit.report.wizard.form</field>
        <field name="model">op.health.visit.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Health Visit History Report">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="patient_type"/>
                </group>
                <footer>
                    <button string="Print" class="btn btn-primary" type="object" name="visit_report" icon="fa-print"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_health_visit_report_wizard" model="ir.actions.act_window">
        <field name="name">Visit History Report</field>
        <field name="res_model">op.health.visit.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
