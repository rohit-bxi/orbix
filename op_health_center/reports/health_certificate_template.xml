<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="health_certificate_pdf_template">
        <t t-call="web.html_container">
        <t t-call="web.external_layout">
            <div class="page" style="position:relative;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;color:#1f2937;">
                <style>
                    .hc-watermark{position:absolute;top:42%;left:50%;transform:translate(-50%,-50%) rotate(-18deg);
                        font-size:66px;font-weight:800;color:#0e7490;opacity:0.055;text-transform:uppercase;white-space:nowrap;z-index:0;}
                    .hc-header{overflow:hidden;border-bottom:3px solid #0e7490;padding-bottom:10px;margin-bottom:16px;position:relative;z-index:1;}
                    .hc-badge{width:56px;height:56px;border-radius:50%;background:linear-gradient(135deg,#0e7490,#06b6d4);
                        color:#ffffff;text-align:center;line-height:56px;font-size:28px;font-weight:700;float:left;margin-right:14px;}
                    .hc-title{font-size:21px;font-weight:700;color:#0e7490;letter-spacing:0.5px;text-transform:uppercase;margin:2px 0 0 0;}
                    .hc-subtitle{font-size:10.5px;color:#6b7280;margin:2px 0 0 0;letter-spacing:0.3px;}
                    .hc-meta{width:100%;font-size:11px;color:#374151;margin-top:10px;}
                    .hc-meta .lbl{color:#6b7280;}
                    .hc-panel{background:#f0fdfa;border:1px solid #99f6e4;border-radius:6px;padding:10px 14px;margin-bottom:14px;position:relative;z-index:1;}
                    .hc-panel-warning{background:#fff7ed;border:1px solid #fdba74;}
                    .hc-panel-title{font-size:10.5px;text-transform:uppercase;letter-spacing:0.5px;color:#0e7490;font-weight:700;margin-bottom:6px;}
                    table.hc-info{width:100%;border-collapse:collapse;}
                    table.hc-info td{padding:3px 6px;font-size:11.5px;vertical-align:top;}
                    table.hc-info td.lbl{color:#6b7280;width:130px;}
                    .hc-statement{font-size:13px;line-height:1.8;margin:16px 0;text-align:justify;position:relative;z-index:1;}
                    table.hc-table{width:100%;border-collapse:collapse;font-size:11px;position:relative;z-index:1;}
                    table.hc-table th{background:#0e7490;color:#ffffff;padding:6px 8px;text-align:left;font-weight:600;}
                    table.hc-table td{padding:6px 8px;border-bottom:1px solid #e5e7eb;}
                    table.hc-table tr:nth-child(even) td{background:#f8fafc;}
                    .hc-status{display:inline-block;padding:3px 12px;border-radius:12px;font-weight:700;font-size:11px;color:#ffffff;}
                    .hc-status-fit{background:#16a34a;}
                    .hc-status-unfit{background:#dc2626;}
                    .hc-status-attention{background:#d97706;}
                    .hc-vitals{width:100%;border-collapse:collapse;margin-top:4px;}
                    .hc-vitals td{width:33%;padding:8px;text-align:center;border:1px solid #e5e7eb;}
                    .hc-vitals .v-label{display:block;font-size:9.5px;color:#6b7280;text-transform:uppercase;letter-spacing:0.4px;}
                    .hc-vitals .v-value{display:block;font-size:16px;font-weight:700;color:#0e7490;margin-top:2px;}
                    .hc-footer{margin-top:56px;width:100%;position:relative;z-index:1;}
                    .hc-sign{text-align:center;font-size:10.5px;color:#374151;}
                    .hc-sign .line{border-top:1px solid #374151;width:170px;margin:36px auto 4px auto;}
                    .hc-note{font-size:9px;color:#9ca3af;margin-top:18px;text-align:center;position:relative;z-index:1;}
                </style>

                <div class="hc-watermark" t-out="(company and company.name) or ''"/>

                <div class="hc-header">
                    <div class="hc-badge">+</div>
                    <div>
                        <p class="hc-title" t-out="certificate_type_label"/>
                        <p class="hc-subtitle">School Health &amp; Wellness Center</p>
                    </div>
                    <div class="hc-meta">
                        <span style="float:left;">
                            <span class="lbl">Certificate No.:</span> <strong t-out="certificate_no"/>
                        </span>
                        <span style="float:right;">
                            <span class="lbl">Date of Issue:</span>
                            <strong><t t-esc="certificate_date" t-options="{'widget': 'date'}"/></strong>
                        </span>
                        <div style="clear:both;"/>
                    </div>
                </div>

                <div class="hc-panel">
                    <div class="hc-panel-title">Patient Information</div>
                    <table class="hc-info">
                        <tr>
                            <td class="lbl">Full Name</td>
                            <td><strong t-out="patient_name"/></td>
                            <td class="lbl">Patient Type</td>
                            <td t-out="patient_type_label"/>
                        </tr>
                        <tr>
                            <td class="lbl">Registration / ID No.</td>
                            <td t-out="patient_reg_no or '—'"/>
                            <td class="lbl">Class / Department</td>
                            <td t-out="patient_affiliation or '—'"/>
                        </tr>
                        <tr>
                            <td class="lbl">Gender</td>
                            <td t-out="patient_gender or '—'"/>
                            <td class="lbl">Age</td>
                            <td t-out="'%s yrs' % patient_age if patient_age is not None else '—'"/>
                        </tr>
                        <tr>
                            <td class="lbl">Blood Group</td>
                            <td t-out="blood_group or '—'"/>
                            <td class="lbl">Known Allergy</td>
                            <td t-out="allergy if is_allergy and allergy else 'None reported'"/>
                        </tr>
                    </table>
                </div>

                <!-- ==================== VACCINATION CERTIFICATE ==================== -->
                <t t-if="certificate_type == 'vaccination'">
                    <p class="hc-statement">
                        This is to certify that the above-named <t t-out="patient_type_label.lower()"/>,
                        <strong t-out="patient_name"/>, has received the vaccination(s) listed below at the
                        <strong t-out="(company and company.name) or 'school'"/> Health Center, as per the immunization
                        records maintained by this institution.
                        <t t-if="date_from or date_to">
                            This record covers the period from
                            <strong><t t-esc="date_from" t-options="{'widget': 'date'}" t-if="date_from"/><t t-if="not date_from">the beginning of records</t></strong>
                            to
                            <strong><t t-esc="date_to" t-options="{'widget': 'date'}" t-if="date_to"/><t t-if="not date_to">date</t></strong>.
                        </t>
                    </p>

                    <t t-if="vaccinations">
                        <table class="hc-table">
                            <thead>
                                <tr>
                                    <th>Vaccine</th>
                                    <th>Dose</th>
                                    <th>Date Administered</th>
                                    <th>Batch No.</th>
                                    <th>Next Due</th>
                                    <th>Administered By</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="vaccinations" t-as="vac">
                                    <tr>
                                        <td t-out="vac['vaccine_name']"/>
                                        <td t-out="vac['dose_number']"/>
                                        <td><t t-esc="vac['date_administered']" t-options="{'widget': 'date'}"/></td>
                                        <td t-out="vac['batch_no'] or '—'"/>
                                        <td>
                                            <t t-if="vac['next_due_date']"><t t-esc="vac['next_due_date']" t-options="{'widget': 'date'}"/></t>
                                            <t t-if="not vac['next_due_date']">—</t>
                                        </td>
                                        <td t-out="vac['administered_by'] or '—'"/>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <p style="font-size:11px;color:#374151;margin-top:10px;">
                            Total completed vaccination(s) on record: <strong t-out="len(vaccinations)"/>
                        </p>
                    </t>
                    <t t-if="not vaccinations">
                        <div class="hc-panel hc-panel-warning">
                            No completed vaccination records were found for the selected period.
                        </div>
                    </t>
                </t>

                <!-- ==================== FITNESS CERTIFICATE ==================== -->
                <t t-if="certificate_type == 'fitness'">
                    <t t-if="latest_checkup">
                        <p class="hc-statement">
                            This is to certify that <strong t-out="patient_name"/> was examined at the
                            <strong t-out="(company and company.name) or 'school'"/> Health Center on
                            <strong><t t-esc="latest_checkup['checkup_date']" t-options="{'widget': 'date'}"/></strong>
                            and, based on the findings recorded below, is medically assessed as:
                        </p>
                        <div style="text-align:center;margin:14px 0;">
                            <span t-attf-class="hc-status hc-status-#{'fit' if latest_checkup['fitness_status'] == 'fit' else ('unfit' if latest_checkup['fitness_status'] == 'unfit' else 'attention')}"
                                  t-out="latest_checkup['fitness_status_label'] or 'Not Assessed'"/>
                        </div>

                        <table class="hc-vitals">
                            <tr>
                                <td>
                                    <span class="v-label">Height</span>
                                    <span class="v-value" t-out="'%s cm' % latest_checkup['height_cm'] if latest_checkup['height_cm'] else '—'"/>
                                </td>
                                <td>
                                    <span class="v-label">Weight</span>
                                    <span class="v-value" t-out="'%s kg' % latest_checkup['weight_kg'] if latest_checkup['weight_kg'] else '—'"/>
                                </td>
                                <td>
                                    <span class="v-label">BMI</span>
                                    <span class="v-value" t-out="'%.1f' % latest_checkup['bmi'] if latest_checkup['bmi'] else '—'"/>
                                    <span class="v-label" t-out="latest_checkup['bmi_category'] or ''"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <span class="v-label">Blood Pressure</span>
                                    <span class="v-value" style="font-size:13px;" t-out="latest_checkup['blood_pressure'] or '—'"/>
                                </td>
                                <td>
                                    <span class="v-label">Vision (L / R)</span>
                                    <span class="v-value" style="font-size:13px;" t-out="'%s / %s' % (latest_checkup['vision_left'] or '—', latest_checkup['vision_right'] or '—')"/>
                                </td>
                                <td>
                                    <span class="v-label">Dental Status</span>
                                    <span class="v-value" style="font-size:13px;" t-out="latest_checkup['dental_status'] or '—'"/>
                                </td>
                            </tr>
                        </table>

                        <t t-if="latest_checkup['general_remarks']">
                            <p style="font-size:11.5px;color:#374151;margin-top:14px;">
                                <strong>Examining Officer's Remarks:</strong> <t t-out="latest_checkup['general_remarks']"/>
                            </p>
                        </t>
                        <p style="font-size:11px;color:#6b7280;margin-top:6px;" t-if="latest_checkup['conducted_by']">
                            Examined by: <t t-out="latest_checkup['conducted_by']"/>
                        </p>
                        <p class="hc-statement">
                            This certificate is issued on the basis of the above examination and is valid for
                            participation in school activities, sports and general purposes unless otherwise stated.
                        </p>
                    </t>
                    <t t-if="not latest_checkup">
                        <div class="hc-panel hc-panel-warning">
                            No completed health checkup was found on record. Please conduct a checkup before
                            issuing this certificate.
                        </div>
                    </t>
                </t>

                <!-- ==================== GENERAL MEDICAL CERTIFICATE ==================== -->
                <t t-if="certificate_type == 'general'">
                    <p class="hc-statement">
                        This is to certify that <strong t-out="patient_name"/>
                        <t t-if="patient_affiliation"> of <strong t-out="patient_affiliation"/></t>
                        is a registered <t t-out="patient_type_label.lower()"/> with
                        <strong t-out="(company and company.name) or 'this institution'"/> and is under the medical
                        supervision of the school health center. This certificate is issued for general purposes
                        based on the health records maintained for the above-named individual.
                    </p>

                    <t t-if="latest_checkup">
                        <div class="hc-panel">
                            <div class="hc-panel-title">Most Recent Health Checkup</div>
                            <table class="hc-info">
                                <tr>
                                    <td class="lbl">Checkup Date</td>
                                    <td><t t-esc="latest_checkup['checkup_date']" t-options="{'widget': 'date'}"/></td>
                                    <td class="lbl">Fitness Status</td>
                                    <td t-out="latest_checkup['fitness_status_label'] or '—'"/>
                                </tr>
                                <tr>
                                    <td class="lbl">Height / Weight</td>
                                    <td t-out="'%s cm / %s kg' % (latest_checkup['height_cm'] or '—', latest_checkup['weight_kg'] or '—')"/>
                                    <td class="lbl">BMI</td>
                                    <td t-out="'%.1f (%s)' % (latest_checkup['bmi'], latest_checkup['bmi_category']) if latest_checkup['bmi'] else '—'"/>
                                </tr>
                            </table>
                        </div>
                    </t>

                    <p style="font-size:11.5px;color:#374151;">
                        Vaccination records on file: <strong t-out="len(vaccinations)"/> completed dose(s).
                    </p>

                    <p class="hc-statement">
                        No further medical remarks are recorded against this individual at the time of issue,
                        unless explicitly noted above.
                    </p>
                </t>

                <div class="hc-footer">
                    <table style="width:100%;">
                        <tr>
                            <td style="width:33%;">
                                <img t-att-src="'/report/barcode/?barcode_type=Code128&amp;value=%s&amp;width=300&amp;height=60&amp;humanreadable=1' % certificate_no"
                                     style="max-height:45px;"/>
                            </td>
                            <td style="width:34%;"/>
                            <td style="width:33%;" class="hc-sign">
                                <div class="line"/>
                                Health Officer / Nurse
                            </td>
                        </tr>
                    </table>
                </div>

                <p class="hc-note">
                    This is a system-generated certificate issued by the School Health &amp; Wellness Center.
                    For verification, please quote Certificate No. <t t-out="certificate_no"/>.
                </p>
            </div>
        </t>
        </t>
    </template>
</odoo>
