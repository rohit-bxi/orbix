<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_health_vaccine_type_list" model="ir.ui.view">
        <field name="name">op.health.vaccine.type.list</field>
        <field name="model">op.health.vaccine.type</field>
        <field name="arch" type="xml">
            <list string="Vaccine Types">
                <field name="name"/>
                <field name="code"/>
                <field name="doses_required"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_health_vaccine_type_form" model="ir.ui.view">
        <field name="name">op.health.vaccine.type.form</field>
        <field name="model">op.health.vaccine.type</field>
        <field name="arch" type="xml">
            <form string="Vaccine Type">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. MMR"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="doses_required"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_health_vaccine_type_search" model="ir.ui.view">
        <field name="name">op.health.vaccine.type.search</field>
        <field name="model">op.health.vaccine.type</field>
        <field name="arch" type="xml">
            <search string="Vaccine Types">
                <field name="name"/>
                <field name="code"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_health_vaccine_type" model="ir.actions.act_window">
        <field name="name">Vaccine Types</field>
        <field name="res_model">op.health.vaccine.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
