<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_batch_class_manager_list" model="ir.ui.view">
        <field name="name">op.batch.class.manager.list</field>
        <field name="model">op.batch</field>
        <field name="arch" type="xml">
            <list string="Class Manager">
                <field name="course_id" string="Class" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="name" string="Section"/>
                <field name="capacity"/>
                <field name="class_teacher_id" options="{'no_create': True, 'no_create_edit': True}"/>
            </list>
        </field>
    </record>

    <record id="view_batch_class_manager_form" model="ir.ui.view">
        <field name="name">op.batch.class.manager.form</field>
        <field name="model">op.batch</field>
        <field name="arch" type="xml">
            <form string="Class Manager">
                <sheet>
                    <group>
                        <group>
                            <field name="course_id" string="Class" placeholder="Select a class"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="capacity" placeholder="e.g., 30"/>
                        </group>
                        <group>
                            <field name="name" string="Section" placeholder="e.g., Section A"/>
                            <field name="class_teacher_id" string="Assign Teacher" placeholder="Select Teacher"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" nolabel="1" placeholder="Description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_batch_class_manager" model="ir.actions.act_window">
        <field name="name">Class Manager</field>
        <field name="res_model">op.batch</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_batch_class_manager_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_batch_class_manager_form')})]"/>
    </record>

    <!-- Surface the new fields on the standard Batch form too -->
    <record id="view_op_batch_form_class_manager_inherit" model="ir.ui.view">
        <field name="name">op.batch.form.class.manager.inherit</field>
        <field name="model">op.batch</field>
        <field name="inherit_id" ref="openeducat_core.view_op_batch_form"/>
        <field name="arch" type="xml">
            <field name="code" position="after">
                <field name="capacity"/>
                <field name="class_teacher_id" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="description"/>
            </field>
        </field>
    </record>
</odoo>
