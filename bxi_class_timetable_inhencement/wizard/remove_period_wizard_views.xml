<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_remove_period_wizard_form" model="ir.ui.view">
        <field name="name">bxi.remove.period.wizard.form</field>
        <field name="model">bxi.remove.period.wizard</field>
        <field name="arch" type="xml">
            <form string="Remove Period?">
                <field name="line_id" invisible="1"/>
                <p>Are you sure you want to remove this period from the schedule?</p>
                <group>
                    <field name="day" readonly="1"/>
                    <field name="timing_id" string="Time" readonly="1"/>
                    <field name="subject_id" readonly="1"/>
                    <field name="class_section" string="Class" readonly="1"/>
                </group>
                <p class="text-muted">
                    Note: this will free up the class period. You'll need to assign another
                    teacher or leave it unassigned.
                </p>
                <footer>
                    <button string="Remove Period" type="object" name="action_remove_period" class="btn-danger"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_remove_period_wizard" model="ir.actions.act_window">
        <field name="name">Remove Period</field>
        <field name="res_model">bxi.remove.period.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
