<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_reassign_class_wizard_form" model="ir.ui.view">
        <field name="name">bxi.reassign.class.wizard.form</field>
        <field name="model">bxi.reassign.class.wizard</field>
        <field name="arch" type="xml">
            <form string="Reassign Class">
                <group>
                    <field name="teacher_id" readonly="1" options="{'no_create': True, 'no_create_edit': True}"/>
                </group>
                <group>
                    <group string="Current Class">
                        <field name="current_course_id" string="Class" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="current_batch_id" string="Section" options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                    <group string="New Class">
                        <field name="new_course_id" string="Class" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="new_batch_id" string="Section" options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                </group>
                <footer>
                    <button string="Confirm" type="object" name="action_reassign" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_reassign_class_wizard" model="ir.actions.act_window">
        <field name="name">Reassign Class</field>
        <field name="res_model">bxi.reassign.class.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
