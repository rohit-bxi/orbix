<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_transfer_period_wizard_form" model="ir.ui.view">
        <field name="name">bxi.transfer.period.wizard.form</field>
        <field name="model">bxi.transfer.period.wizard</field>
        <field name="arch" type="xml">
            <form string="Transfer Period">
                <group>
                    <field name="from_teacher_id" string="From Teacher" readonly="1"
                           options="{'no_create': True, 'no_create_edit': True}"/>
                </group>
                <group>
                    <field name="course_id" string="Class" options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="batch_id" string="Section" options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="day"/>
                    <field name="timing_id" string="Time" options="{'no_create': True, 'no_create_edit': True}"/>
                </group>
                <group>
                    <field name="to_teacher_id" string="Transfer To" options="{'no_create': True, 'no_create_edit': True}"/>
                </group>
                <footer>
                    <button string="Transfer Period" type="object" name="action_transfer" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_transfer_period_wizard" model="ir.actions.act_window">
        <field name="name">Transfer Period</field>
        <field name="res_model">bxi.transfer.period.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
