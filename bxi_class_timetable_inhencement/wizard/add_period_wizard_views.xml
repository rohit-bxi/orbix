<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_add_period_wizard_form" model="ir.ui.view">
        <field name="name">bxi.add.period.wizard.form</field>
        <field name="model">bxi.add.period.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Period">
                <group>
                    <field name="teacher_id" options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="course_id" string="Class" options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="batch_id" string="Section" options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="day"/>
                    <field name="timing_id" string="Time Period" options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="subject_id" options="{'no_create': True, 'no_create_edit': True}"/>
                </group>
                <footer>
                    <button string="Add Period" type="object" name="action_add_period" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_add_period_wizard" model="ir.actions.act_window">
        <field name="name">Add Period</field>
        <field name="res_model">bxi.add.period.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
