<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_class_timetable" model="ir.module.category">
        <field name="name">Class and Timetable</field>
        <field name="sequence">29</field>
    </record>

    <record id="privilege_class_timetable" model="res.groups.privilege">
        <field name="name">Class and Timetable</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_class_timetable"/>
    </record>

    <record id="group_class_timetable_coordinator" model="res.groups">
        <field name="name">Timetable Coordinator</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_class_timetable"/>
    </record>

    <record id="group_class_timetable_manager" model="res.groups">
        <field name="name">Timetable Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_class_timetable"/>
        <field name="implied_ids" eval="[(4, ref('group_class_timetable_coordinator'))]"/>
    </record>
</odoo>
