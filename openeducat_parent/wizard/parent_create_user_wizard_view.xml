<odoo>

        <record id="op_parent_user_create_view" model="ir.ui.view">
            <field name="name">wizard.op.parent.form</field>
            <field name="model">wizard.op.parent</field>
            <field name="arch" type="xml">
                <form string="Create Users">
                    <p class="oe_grey">Create User For Selected Parents</p>
                    <separator string="Parents" colspan="4"/>
                    <field name="parent_ids" widget="many2many_tags" readonly="1"/>
                    <footer>
                        <button string="Create Users" name="create_user" type="object" default_focus="1"
                                class="oe_highlight"/>
                        <button string="Cancel" class="btn-secondary ms-1" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="parent_user_create_view_act">
            <field name="name">Create Users</field>
            <field name="res_model">wizard.op.parent</field>
            <field name="binding_view_types">list,form</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="model_op_parent"/>
        </record>

</odoo>
