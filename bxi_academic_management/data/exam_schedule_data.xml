<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- The exam type an exam gets when none is chosen, so a school with no
         exam types set up can still add exams. -->
    <record id="exam_type_general" model="op.exam.type">
        <field name="name">General</field>
        <field name="code">GEN</field>
    </record>

    <!-- Codes of the per-section sessions an exam creates: EXS/26/0001. -->
    <record id="seq_exam_schedule_session" model="ir.sequence">
        <field name="name">Exam Schedule Session Code</field>
        <field name="code">bxi.exam.schedule.session</field>
        <field name="prefix">EXS/%(range_y)s/</field>
        <field name="padding">4</field>
        <field name="use_date_range" eval="True"/>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
