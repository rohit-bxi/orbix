<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="curriculum_rule_company" model="ir.rule">
        <field name="name">Curriculum: Multi-company</field>
        <field name="model_id" ref="model_bxi_curriculum"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="subject_mapping_rule_company" model="ir.rule">
        <field name="name">Subject Mapping: Multi-company</field>
        <field name="model_id" ref="model_bxi_subject_mapping"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="ptm_meeting_rule_company" model="ir.rule">
        <field name="name">PTM Meeting: Multi-company</field>
        <field name="model_id" ref="model_bxi_ptm_meeting"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="ptm_meeting_rule_teacher" model="ir.rule">
        <field name="name">PTM Meeting: Teacher sees own classes</field>
        <field name="model_id" ref="model_bxi_ptm_meeting"/>
        <field name="domain_force">[('teacher_ids.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('openeducat_core.group_op_faculty'))]"/>
    </record>

    <record id="ptm_meeting_rule_portal_parent" model="ir.rule">
        <field name="name">PTM Meeting: Portal parent own children's classes</field>
        <field name="model_id" ref="model_bxi_ptm_meeting"/>
        <field name="domain_force">[('parent_ids.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>
</odoo>
