<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_board_list" model="ir.ui.view">
        <field name="name">bxi.board.list</field>
        <field name="model">bxi.board</field>
        <field name="arch" type="xml">
            <list string="Boards" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_board_form" model="ir.ui.view">
        <field name="name">bxi.board.form</field>
        <field name="model">bxi.board</field>
        <field name="arch" type="xml">
            <form string="Board">
                <sheet>
                    <group>
                        <field name="name" placeholder="e.g., CBSE, ICSE, State Board"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_board" model="ir.actions.act_window">
        <field name="name">Boards</field>
        <field name="res_model">bxi.board</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
