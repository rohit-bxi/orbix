<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_curriculum_list" model="ir.ui.view">
        <field name="name">bxi.curriculum.list</field>
        <field name="model">bxi.curriculum</field>
        <field name="arch" type="xml">
            <list string="Curriculums">
                <field name="name"/>
                <field name="board_id" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="class_ids" widget="many2many_tags"/>
                <field name="approval_status" widget="badge"
                       decoration-success="approval_status == 'approved'"
                       decoration-danger="approval_status == 'rejected'"
                       decoration-info="approval_status == 'draft'"/>
                <field name="locked" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_curriculum_form" model="ir.ui.view">
        <field name="name">bxi.curriculum.form</field>
        <field name="model">bxi.curriculum</field>
        <field name="arch" type="xml">
            <form string="Curriculum">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="not id or approval_status == 'approved'"
                            groups="bxi_academic_management.group_academic_manager"/>
                    <button name="action_reject" type="object" string="Reject" class="btn-secondary"
                            invisible="not id or approval_status == 'rejected'"
                            groups="bxi_academic_management.group_academic_manager"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="not id or approval_status == 'draft'"
                            groups="bxi_academic_management.group_academic_manager"/>
                    <button name="action_toggle_lock" type="object" string="Unlock" class="btn-secondary"
                            invisible="not id or not locked"
                            groups="bxi_academic_management.group_academic_manager"/>
                    <button name="action_toggle_lock" type="object" string="Lock" class="btn-secondary"
                            invisible="not id or locked"
                            groups="bxi_academic_management.group_academic_manager"/>
                    <button name="action_open_assign_classes" type="object"
                            string="Assign Classes" class="btn-secondary"
                            invisible="not id"/>
                    <button name="action_open_map_projects" type="object"
                            string="Map Projects" class="btn-secondary"
                            invisible="not id"/>
                    <field name="approval_status" widget="statusbar" statusbar_visible="draft,approved"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Locked" bg_color="text-bg-danger" invisible="not locked"/>
                    <group>
                        <field name="class_ids" widget="many2many_tags"
                               placeholder="Select Board Class" readonly="locked"/>
                        <field name="name" placeholder="e.g., CBSE Curriculum 2026"/>
                        <field name="board_id" placeholder="Select Board" readonly="locked"
                               options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="project_ids" widget="many2many_tags"
                               placeholder="e.g., Science Fair, Math Olympiad"/>
                        <field name="description" placeholder="Enter curriculum description"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_curriculum_form_assign_classes" model="ir.ui.view">
        <field name="name">bxi.curriculum.form.assign.classes</field>
        <field name="model">bxi.curriculum</field>
        <field name="arch" type="xml">
            <form string="Assign Classes">
                <sheet>
                    <group>
                        <field name="class_ids" widget="many2many_tags"
                               placeholder="e.g., Class 9, Class 10" readonly="locked"/>
                        <field name="name" readonly="1"/>
                        <field name="board_id" readonly="1"
                               options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_curriculum_form_map_projects" model="ir.ui.view">
        <field name="name">bxi.curriculum.form.map.projects</field>
        <field name="model">bxi.curriculum</field>
        <field name="arch" type="xml">
            <form string="Map Projects">
                <sheet>
                    <group>
                        <field name="project_ids" widget="many2many_tags"
                               placeholder="e.g., Science Fair, Math Olympiad"/>
                        <field name="name" readonly="1"/>
                        <field name="board_id" readonly="1"
                               options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_curriculum_search" model="ir.ui.view">
        <field name="name">bxi.curriculum.search</field>
        <field name="model">bxi.curriculum</field>
        <field name="arch" type="xml">
            <search string="Curriculums">
                <field name="name"/>
                <field name="board_id" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="class_ids"/>
                <field name="project_ids"/>
                <filter string="Draft" name="filter_draft" domain="[('approval_status', '=', 'draft')]"/>
                <filter string="Approved" name="filter_approved" domain="[('approval_status', '=', 'approved')]"/>
                <filter string="Locked" name="filter_locked" domain="[('locked', '=', True)]"/>
                <separator/>
                <group name="group_by">
                    <filter string="Board" name="group_board" context="{'group_by': 'board_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'approval_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_curriculum" model="ir.actions.act_window">
        <field name="name">Curriculum</field>
        <field name="res_model">bxi.curriculum</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
