<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_curriculum_list" model="ir.ui.view">
        <field name="name">bxi.curriculum.list</field>
        <field name="model">bxi.curriculum</field>
        <field name="arch" type="xml">
            <list string="Curriculums">
                <field name="name"/>
                <field name="board_id" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="class_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_curriculum_form" model="ir.ui.view">
        <field name="name">bxi.curriculum.form</field>
        <field name="model">bxi.curriculum</field>
        <field name="arch" type="xml">
            <form string="Curriculum">
                <header>
                    <button name="action_open_assign_classes" type="object"
                            string="Assign Classes" class="btn-secondary"
                            invisible="not id"/>
                </header>
                <sheet>
                    <group>
                        <field name="class_ids" widget="many2many_tags"
                               placeholder="Select Board Class"/>
                        <field name="name" placeholder="e.g., CBSE Curriculum 2026"/>
                        <field name="board_id" placeholder="Select Board"
                               options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="description" placeholder="Enter curriculum description"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_curriculum_form_assign_classes" model="ir.ui.view">
        <field name="name">bxi.curriculum.form.assign.classes</field>
        <field name="model">bxi.curriculum</field>
        <field name="arch" type="xml">
            <form string="Assign Classes">
                <sheet>
                    <group>
                        <field name="class_ids" widget="many2many_tags"
                               placeholder="e.g., Class 9, Class 10"/>
                        <field name="name" readonly="1"/>
                        <field name="board_id" readonly="1"
                               options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_curriculum_search" model="ir.ui.view">
        <field name="name">bxi.curriculum.search</field>
        <field name="model">bxi.curriculum</field>
        <field name="arch" type="xml">
            <search string="Curriculums">
                <field name="name"/>
                <field name="board_id" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="class_ids"/>
                <group name="group_by">
                    <filter string="Board" name="group_board" context="{'group_by': 'board_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_curriculum" model="ir.actions.act_window">
        <field name="name">Curriculum</field>
        <field name="res_model">bxi.curriculum</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
