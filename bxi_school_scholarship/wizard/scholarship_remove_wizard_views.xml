<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_scholarship_remove_wizard_form" model="ir.ui.view">
        <field name="name">bxi.scholarship.remove.wizard.form</field>
        <field name="model">bxi.scholarship.remove.wizard</field>
        <field name="arch" type="xml">
            <form string="Remove Student Scholarship">
                <div class="alert alert-danger" role="alert">
                    <strong>Warning: This Action Cannot Be Undone</strong><br/>
                    Removing this scholarship will affect the student's fee structure and they will be
                    required to pay the full amount. This action is permanent and cannot be reversed.
                </div>
                <group string="Student Information">
                    <field name="student_id" readonly="1"/>
                    <field name="class_id" readonly="1"/>
                </group>
                <group string="Scholarship to be Removed">
                    <group>
                        <field name="scholarship_type" readonly="1"/>
                        <field name="program_id" readonly="1"/>
                        <field name="name" readonly="1"/>
                        <field name="academic_year_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="coverage_percentage" readonly="1"/>
                        <field name="approval_status" readonly="1"/>
                        <field name="valid_from" readonly="1"/>
                        <field name="valid_until" readonly="1"/>
                    </group>
                </group>
                <group string="Financial Impact">
                    <field name="lost_scholarship_amount" readonly="1"/>
                    <field name="current_pending_amount" readonly="1"/>
                    <field name="new_pending_amount" readonly="1"/>
                    <field name="currency_id" invisible="1"/>
                </group>
                <group string="Confirmation Required">
                    <field name="confirmation_text" placeholder="Type REMOVE to confirm"/>
                </group>
                <footer>
                    <button name="action_confirm_remove" type="object" string="Remove Scholarship" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_scholarship_remove_wizard" model="ir.actions.act_window">
        <field name="name">Remove Scholarship</field>
        <field name="res_model">bxi.scholarship.remove.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_scholarship_id': active_id}</field>
        <field name="binding_model_id" ref="model_bxi_student_scholarship"/>
        <field name="binding_view_types">form,list</field>
    </record>
</odoo>
