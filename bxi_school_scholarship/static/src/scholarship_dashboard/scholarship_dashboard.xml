<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="bxi_school_scholarship.ScholarshipDashboard">
        <div class="o_scholarship_dashboard h-100 overflow-auto p-3">
            <div class="o_scholarship_dashboard_header d-flex justify-content-between align-items-start mb-4">
                <div>
                    <h2 class="mb-1">Scholarship Statistics &amp; Analytics</h2>
                    <div class="text-muted">Comprehensive overview of scholarship programs and their impact.</div>
                </div>
                <button type="button" class="btn btn-primary" t-on-click="exportFullReport">Export Full Report</button>
            </div>

            <!-- KPI cards -->
            <div class="row g-3 mb-4">
                <t t-foreach="kpiDefs" t-as="def" t-key="def.key">
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="o_scholarship_kpi_card">
                            <div t-attf-class="o_scholarship_kpi_icon o_scholarship_kpi_icon_{{def.color}}">
                                <i t-attf-class="fa {{def.icon}}"/>
                            </div>
                            <div class="o_scholarship_kpi_value" t-esc="formatKpi(def)"/>
                            <div class="o_scholarship_kpi_label" t-esc="def.label"/>
                        </div>
                    </div>
                </t>
            </div>

            <!-- Scholarship Student List -->
            <div class="o_scholarship_dashboard_panel mb-4">
                <div class="o_scholarship_dashboard_panel_header d-flex justify-content-between align-items-center">
                    <span>Scholarship Student List</span>
                    <button type="button" class="btn btn-primary btn-sm" t-on-click="viewAllStudents">View All</button>
                </div>
                <div class="table-responsive">
                    <table class="table o_scholarship_table mb-0">
                        <thead>
                            <tr>
                                <th>Student Name</th>
                                <th>Scholarship Type</th>
                                <th>Coverage</th>
                                <th>Approval Status</th>
                                <th>Balance</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-if="!state.studentList.length">
                                <td colspan="6" class="text-muted text-center py-3">No scholarships found</td>
                            </tr>
                            <tr t-foreach="state.studentList" t-as="row" t-key="row.id">
                                <td t-esc="row.student_name"/>
                                <td t-esc="row.scholarship_name"/>
                                <td t-esc="coverageLabel(row)"/>
                                <td>
                                    <span t-attf-class="badge {{statusBadgeClass(row.approval_status)}}" t-esc="row.approval_status"/>
                                </td>
                                <td t-esc="formatAmount(row.balance)"/>
                                <td>
                                    <a href="#" class="o_scholarship_row_action" t-on-click.prevent="() => this.openRecord(row.id)" title="View">
                                        <i class="fa fa-eye"/>
                                    </a>
                                    <a href="#" class="o_scholarship_row_action" t-on-click.prevent="() => this.openRecord(row.id)" title="Edit">
                                        <i class="fa fa-pencil"/>
                                    </a>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Charts row 1 -->
            <div class="row g-3 mb-4">
                <div class="col-12 col-lg-6">
                    <div class="o_scholarship_dashboard_panel h-100">
                        <div class="o_scholarship_dashboard_panel_header">Scholarship Type Distribution</div>
                        <div class="o_scholarship_chart_container p-3">
                            <canvas t-ref="typeDistribution"/>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6">
                    <div class="o_scholarship_dashboard_panel h-100">
                        <div class="o_scholarship_dashboard_panel_header">Budget Allocation vs Utilization</div>
                        <div class="p-3">
                            <t t-set="budget" t-value="state.chartsData.budget_allocation"/>
                            <t t-if="budget">
                                <div class="o_scholarship_budget_row">
                                    <div class="d-flex justify-content-between">
                                        <span>Total Budget</span>
                                        <span class="fw-semibold" t-esc="formatAmount(budget.total_budget)"/>
                                    </div>
                                    <div class="o_scholarship_progress"><div class="o_scholarship_progress_bar o_scholarship_progress_blue" style="width: 100%"/></div>
                                </div>
                                <div class="o_scholarship_budget_row">
                                    <div class="d-flex justify-content-between">
                                        <span>Amount Disbursed</span>
                                        <span class="fw-semibold" t-esc="formatAmount(budget.amount_disbursed)"/>
                                    </div>
                                    <div class="o_scholarship_progress">
                                        <div class="o_scholarship_progress_bar o_scholarship_progress_green"
                                             t-attf-style="width: {{budget.total_budget ? (budget.amount_disbursed / budget.total_budget * 100) : 0}}%"/>
                                    </div>
                                </div>
                                <div class="o_scholarship_budget_row">
                                    <div class="d-flex justify-content-between">
                                        <span>Remaining Budget</span>
                                        <span class="fw-semibold" t-esc="formatAmount(budget.remaining_budget)"/>
                                    </div>
                                    <div class="o_scholarship_progress">
                                        <div class="o_scholarship_progress_bar o_scholarship_progress_orange"
                                             t-attf-style="width: {{budget.total_budget ? (budget.remaining_budget / budget.total_budget * 100) : 0}}%"/>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Class-wise Recipients -->
            <div class="o_scholarship_dashboard_panel mb-4">
                <div class="o_scholarship_dashboard_panel_header">Class-wise Recipients</div>
                <div class="o_scholarship_chart_container_lg p-3">
                    <canvas t-ref="classWiseRecipients"/>
                </div>
            </div>

            <!-- Top Performing Scholarships -->
            <div class="o_scholarship_dashboard_panel mb-4">
                <div class="o_scholarship_dashboard_panel_header">Top Performing Scholarships</div>
                <div class="table-responsive">
                    <table class="table o_scholarship_table mb-0">
                        <thead>
                            <tr>
                                <th>Scholarship Name</th>
                                <th>Recipients</th>
                                <th>Budget</th>
                                <th>Utilization</th>
                                <th>Performance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-if="!state.topPrograms.length">
                                <td colspan="5" class="text-muted text-center py-3">No scholarship programs found</td>
                            </tr>
                            <tr t-foreach="state.topPrograms" t-as="program" t-key="program.name">
                                <td t-esc="program.name"/>
                                <td t-esc="program.recipients"/>
                                <td t-esc="formatAmount(program.budget)"/>
                                <td><t t-esc="program.utilization"/>%</td>
                                <td>
                                    <div class="o_scholarship_progress">
                                        <div class="o_scholarship_progress_bar o_scholarship_progress_green"
                                             t-attf-style="width: {{Math.min(program.utilization, 100)}}%"/>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Monthly Disbursement Trend -->
            <div class="o_scholarship_dashboard_panel mb-4">
                <div class="o_scholarship_dashboard_panel_header">Monthly Disbursement Trend</div>
                <div class="o_scholarship_chart_container_lg p-3">
                    <canvas t-ref="monthlyTrend"/>
                </div>
            </div>

            <!-- Secondary stats -->
            <div class="row g-3 mb-4">
                <t t-foreach="statDefs" t-as="def" t-key="def.key">
                    <div class="col-12 col-md-4">
                        <div class="o_scholarship_kpi_card">
                            <div class="o_scholarship_kpi_value" t-esc="formatStat(def)"/>
                            <div class="o_scholarship_kpi_label" t-esc="def.label"/>
                        </div>
                    </div>
                </t>
            </div>

            <!-- Recent Activity -->
            <div class="o_scholarship_dashboard_panel mb-4">
                <div class="o_scholarship_dashboard_panel_header">Recent Activity</div>
                <div class="p-3">
                    <div t-if="!state.recentActivity.length" class="text-muted">No recent activity</div>
                    <div t-foreach="state.recentActivity" t-as="activity" t-key="activity_index"
                         class="o_scholarship_activity_row d-flex justify-content-between align-items-start">
                        <div>
                            <div class="fw-semibold" t-esc="activity.title"/>
                            <div class="text-muted small" t-esc="activity.date"/>
                        </div>
                        <span t-attf-class="badge {{activityBadgeClass(activity.kind)}}" t-esc="activity.kind"/>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
