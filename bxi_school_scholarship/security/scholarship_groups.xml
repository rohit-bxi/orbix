<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_scholarship" model="ir.module.category">
        <field name="name">Scholarship</field>
        <field name="sequence">28</field>
    </record>

    <record id="privilege_scholarship" model="res.groups.privilege">
        <field name="name">Scholarship</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_scholarship"/>
    </record>

    <record id="group_scholarship_staff" model="res.groups">
        <field name="name">Scholarship Staff</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_scholarship"/>
    </record>

    <record id="group_scholarship_manager" model="res.groups">
        <field name="name">Scholarship Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_scholarship"/>
        <field name="implied_ids" eval="[(4, ref('group_scholarship_staff'))]"/>
    </record>
</odoo>
