<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- bxi.student.scholarship -->
    <record id="scholarship_rule_staff" model="ir.rule">
        <field name="name">Student Scholarship: Staff/Manager see all</field>
        <field name="model_id" ref="model_bxi_student_scholarship"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_scholarship_staff'))]"/>
    </record>

    <record id="scholarship_rule_self" model="ir.rule">
        <field name="name">Student Scholarship: Self read-only</field>
        <field name="model_id" ref="model_bxi_student_scholarship"/>
        <field name="domain_force">[('student_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

    <record id="scholarship_rule_company" model="ir.rule">
        <field name="name">Student Scholarship: Multi-company</field>
        <field name="model_id" ref="model_bxi_student_scholarship"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- bxi.student.scholarship.fee.line -->
    <record id="scholarship_fee_line_rule_staff" model="ir.rule">
        <field name="name">Student Scholarship Fee Line: Staff/Manager see all</field>
        <field name="model_id" ref="model_bxi_student_scholarship_fee_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_scholarship_staff'))]"/>
    </record>

    <record id="scholarship_fee_line_rule_self" model="ir.rule">
        <field name="name">Student Scholarship Fee Line: Self read-only</field>
        <field name="model_id" ref="model_bxi_student_scholarship_fee_line"/>
        <field name="domain_force">[('scholarship_id.student_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

    <!-- bxi.scholarship.program -->
    <record id="scholarship_program_rule_company" model="ir.rule">
        <field name="name">Scholarship Program: Multi-company</field>
        <field name="model_id" ref="model_bxi_scholarship_program"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
