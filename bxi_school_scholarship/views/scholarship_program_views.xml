<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_scholarship_program_list" model="ir.ui.view">
        <field name="name">bxi.scholarship.program.list</field>
        <field name="model">bxi.scholarship.program</field>
        <field name="arch" type="xml">
            <list string="Scholarship Programs">
                <field name="name"/>
                <field name="scholarship_type"/>
                <field name="default_coverage_type"/>
                <field name="default_coverage_percentage"/>
                <field name="default_max_amount_limit"/>
            </list>
        </field>
    </record>

    <record id="view_scholarship_program_form" model="ir.ui.view">
        <field name="name">bxi.scholarship.program.form</field>
        <field name="model">bxi.scholarship.program</field>
        <field name="arch" type="xml">
            <form string="Scholarship Program">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Merit Excellence Award"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="scholarship_type"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="default_coverage_type"/>
                            <field name="default_coverage_percentage" invisible="default_coverage_type != 'percentage'"/>
                            <field name="default_fixed_amount" invisible="default_coverage_type != 'fixed_amount'"/>
                            <field name="default_max_amount_limit"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Reason/criteria for this scholarship program..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_scholarship_program" model="ir.actions.act_window">
        <field name="name">Scholarship Programs</field>
        <field name="res_model">bxi.scholarship.program</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
