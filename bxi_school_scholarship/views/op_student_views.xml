<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_op_student_form_scholarship" model="ir.ui.view">
        <field name="name">op.student.form.scholarship</field>
        <field name="model">op.student</field>
        <field name="inherit_id" ref="openeducat_core.view_op_student_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_scholarships" icon="fa-graduation-cap"
                        groups="bxi_school_scholarship.group_scholarship_staff,bxi_school_scholarship.group_scholarship_manager">
                    <field string="Scholarships" name="scholarship_count" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
