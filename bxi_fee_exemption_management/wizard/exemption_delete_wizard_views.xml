<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_fee_exemption_delete_wizard_form" model="ir.ui.view">
        <field name="name">bxi.fee.exemption.delete.wizard.form</field>
        <field name="model">bxi.fee.exemption.delete.wizard</field>
        <field name="arch" type="xml">
            <form string="Delete Fee Exemption">
                <div class="alert alert-danger" role="alert">
                    <strong>Warning: This Action Cannot Be Undone</strong><br/>
                    Deleting this exemption will recalculate the student's fee structure to the original amount.
                    The student will be required to pay the full fee without any exemption benefits. This action is
                    permanent and cannot be reversed.
                </div>
                <group string="Student Information">
                    <field name="student_id" readonly="1"/>
                    <field name="class_id" readonly="1"/>
                </group>
                <group string="Exemption to be Deleted">
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="exemption_type" readonly="1"/>
                        <field name="approval_status" readonly="1"/>
                    </group>
                    <group>
                        <field name="valid_from" readonly="1"/>
                        <field name="valid_until" readonly="1"/>
                    </group>
                </group>
                <group string="Reason" invisible="not reason">
                    <field name="reason" readonly="1" nolabel="1"/>
                </group>
                <group string="Financial Impact Analysis">
                    <field name="lost_exemption_amount" readonly="1"/>
                    <field name="current_pending_amount" readonly="1"/>
                    <field name="new_pending_amount" readonly="1"/>
                    <field name="currency_id" invisible="1"/>
                </group>
                <group string="Confirmation Required">
                    <field name="confirmation_text" placeholder="Type DELETE to confirm"/>
                    <field name="understand_permanent"/>
                    <field name="notify_of_change"/>
                </group>
                <footer>
                    <button name="action_confirm_delete" type="object" string="Delete Exemption" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
