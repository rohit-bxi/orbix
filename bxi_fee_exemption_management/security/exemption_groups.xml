<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_exemption" model="ir.module.category">
        <field name="name">Fee Exemption</field>
        <field name="sequence">30</field>
    </record>

    <record id="privilege_exemption" model="res.groups.privilege">
        <field name="name">Fee Exemption</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_exemption"/>
    </record>

    <record id="group_exemption_staff" model="res.groups">
        <field name="name">Fee Exemption Staff</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_exemption"/>
    </record>

    <record id="group_exemption_manager" model="res.groups">
        <field name="name">Fee Exemption Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_exemption"/>
        <field name="implied_ids" eval="[(4, ref('group_exemption_staff'))]"/>
    </record>
</odoo>
