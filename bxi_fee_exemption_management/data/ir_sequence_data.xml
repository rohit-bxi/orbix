<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_fee_exemption_request" model="ir.sequence">
        <field name="name">Fee Exemption Request</field>
        <field name="code">bxi.fee.exemption.request</field>
        <field name="prefix">EXR/%(year)s/</field>
        <field name="padding">3</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_fee_exemption" model="ir.sequence">
        <field name="name">Fee Exemption</field>
        <field name="code">bxi.fee.exemption</field>
        <field name="prefix">EXM/%(year)s/</field>
        <field name="padding">3</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
