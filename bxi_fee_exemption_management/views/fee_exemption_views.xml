<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_fee_exemption_list" model="ir.ui.view">
        <field name="name">bxi.fee.exemption.list</field>
        <field name="model">bxi.fee.exemption</field>
        <field name="arch" type="xml">
            <list string="Fee Exemptions" decoration-muted="approval_status == 'rejected'">
                <field name="student_id"/>
                <field name="class_id"/>
                <field name="section_id"/>
                <field name="exemption_type"/>
                <field name="exemption_amount"/>
                <field name="valid_until"/>
                <field name="approval_status" widget="badge"
                       decoration-success="approval_status == 'approved'"
                       decoration-warning="approval_status == 'pending'"
                       decoration-danger="approval_status == 'rejected'"
                       decoration-muted="approval_status == 'draft'"/>
                <field name="net_payable_amount" string="Net Payable"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_fee_exemption_form" model="ir.ui.view">
        <field name="name">bxi.fee.exemption.form</field>
        <field name="model">bxi.fee.exemption</field>
        <field name="arch" type="xml">
            <form string="Fee Exemption">
                <header>
                    <button name="action_submit" type="object" string="Submit for Approval" invisible="approval_status != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="oe_highlight" invisible="approval_status != 'pending'"/>
                    <button name="action_reject" type="object" string="Reject" invisible="approval_status != 'pending'"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft" invisible="approval_status not in ('approved', 'rejected')"/>
                    <button name="action_open_delete_wizard" type="object" string="Delete Exemption" class="btn-danger"/>
                    <field name="approval_status" widget="statusbar" statusbar_visible="draft,pending,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Exemption ID"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Student Information">
                            <field name="student_id"/>
                            <field name="parent_ids" invisible="1"/>
                            <field name="parent_id" domain="[('id', 'in', parent_ids)]"/>
                            <field name="class_id" readonly="1"/>
                            <field name="section_id" readonly="1"/>
                            <field name="roll_number" readonly="1"/>
                        </group>
                        <group string="Fee Impact Analysis">
                            <field name="total_fee_amount"/>
                            <field name="exemption_amount"/>
                            <field name="net_payable_amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Exemption Details">
                            <group>
                                <group>
                                    <field name="exemption_type"/>
                                    <field name="category"/>
                                    <field name="exemption_method"/>
                                    <field name="coverage_percentage" invisible="exemption_method != 'percentage'"/>
                                    <field name="fixed_amount" invisible="exemption_method != 'fixed_amount'"/>
                                    <field name="max_exemption_amount"/>
                                </group>
                                <group>
                                    <field name="fee_category_scope"/>
                                    <field name="applicable_fee_category_ids" widget="many2many_tags" invisible="fee_category_scope != 'specific'"/>
                                    <field name="priority_level"/>
                                    <field name="request_id" readonly="1"/>
                                </group>
                            </group>
                            <group>
                                <field name="reason"/>
                            </group>
                            <field name="fee_line_ids">
                                <list editable="bottom">
                                    <field name="fee_category_id"/>
                                    <field name="total_amount"/>
                                    <field name="exemption_applied" readonly="1"/>
                                    <field name="net_amount" readonly="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Validity Period">
                            <group>
                                <field name="valid_from"/>
                                <field name="valid_until"/>
                                <field name="auto_renew"/>
                            </group>
                        </page>
                        <page string="Eligibility Criteria">
                            <group>
                                <group>
                                    <field name="min_academic_percentage"/>
                                    <field name="min_attendance_percentage"/>
                                </group>
                                <group>
                                    <field name="family_income_limit"/>
                                    <field name="sibling_count_required"/>
                                </group>
                            </group>
                            <field name="additional_conditions"/>
                        </page>
                        <page string="Approval Settings">
                            <group>
                                <group>
                                    <field name="approved_by"/>
                                    <field name="approval_date"/>
                                    <field name="next_review_date"/>
                                </group>
                            </group>
                            <field name="approval_notes"/>
                        </page>
                        <page string="Supporting Documents">
                            <field name="document_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Notifications &amp; Notes">
                            <group>
                                <field name="notify_parent"/>
                                <field name="notify_sms"/>
                                <field name="notify_email"/>
                            </group>
                            <group>
                                <field name="internal_notes"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_fee_exemption_search" model="ir.ui.view">
        <field name="name">bxi.fee.exemption.search</field>
        <field name="model">bxi.fee.exemption</field>
        <field name="arch" type="xml">
            <search string="Fee Exemptions">
                <field name="student_id"/>
                <field name="class_id"/>
                <field name="section_id"/>
                <field name="exemption_type"/>
                <filter string="Draft" name="filter_draft" domain="[('approval_status', '=', 'draft')]"/>
                <filter string="Pending" name="filter_pending" domain="[('approval_status', '=', 'pending')]"/>
                <filter string="Approved" name="filter_approved" domain="[('approval_status', '=', 'approved')]"/>
                <separator/>
                <filter string="Expiring Soon" name="filter_expiring_soon"
                        domain="[('valid_until', '&gt;=', context_today().strftime('%Y-%m-%d')),
                                 ('valid_until', '&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Class" name="group_class" context="{'group_by': 'class_id'}"/>
                <filter string="Section" name="group_section" context="{'group_by': 'section_id'}"/>
                <filter string="Exemption Type" name="group_exemption_type" context="{'group_by': 'exemption_type'}"/>
                <filter string="Status" name="group_status" context="{'group_by': 'approval_status'}"/>
            </search>
        </field>
    </record>

    <record id="action_fee_exemption" model="ir.actions.act_window">
        <field name="name">Fee Exemptions</field>
        <field name="res_model">bxi.fee.exemption</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_fee_exemption_search"/>
        <field name="context">{'search_default_group_status': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a fee exemption</p>
        </field>
    </record>
</odoo>
