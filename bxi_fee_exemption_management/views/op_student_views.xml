<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_op_student_form_exemption" model="ir.ui.view">
        <field name="name">op.student.form.exemption</field>
        <field name="model">op.student</field>
        <field name="inherit_id" ref="openeducat_core.view_op_student_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_exemption_requests" icon="fa-file-text-o"
                        groups="bxi_fee_exemption_management.group_exemption_staff,bxi_fee_exemption_management.group_exemption_manager">
                    <field string="Exemption Requests" name="exemption_request_count" widget="statinfo"/>
                </button>
                <button class="oe_stat_button" type="object" name="action_view_exemptions" icon="fa-shield"
                        groups="bxi_fee_exemption_management.group_exemption_staff,bxi_fee_exemption_management.group_exemption_manager">
                    <field string="Fee Exemptions" name="exemption_count" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
