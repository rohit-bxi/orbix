<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_certificate_bulk_wizard_form" model="ir.ui.view">
        <field name="name">op.certificate.bulk.wizard.form</field>
        <field name="model">op.certificate.bulk.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Issue Certificates">
                <group>
                    <field name="certificate_type_id"/>
                    <field name="course_id"/>
                    <field name="batch_id" domain="[('course_id', '=', course_id)]"/>
                    <field name="issue_date"/>
                </group>
                <field name="student_ids" widget="many2many_tags"/>
                <footer>
                    <button string="Create Draft Certificates" class="btn btn-primary" type="object" name="action_create_certificates"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_certificate_bulk_wizard" model="ir.actions.act_window">
        <field name="name">Bulk Issue Certificates</field>
        <field name="res_model">op.certificate.bulk.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
