<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_op_faculty_form_certificate" model="ir.ui.view">
        <field name="name">op.faculty.form.certificate</field>
        <field name="model">op.faculty</field>
        <field name="inherit_id" ref="openeducat_core.view_op_faculty_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_issued_certificates" icon="fa-certificate"
                        groups="bxi_certificate_management.group_certificate_user,bxi_certificate_management.group_certificate_manager">
                    <field string="Issued" name="issued_certificate_count" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
