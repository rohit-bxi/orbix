<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_certificate_list" model="ir.ui.view">
        <field name="name">op.certificate.list</field>
        <field name="model">op.certificate</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('revoked', 'expired')" decoration-warning="expiring_soon">
                <field name="certificate_number"/>
                <field name="student_id"/>
                <field name="certificate_type_id"/>
                <field name="course_id"/>
                <field name="batch_id"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="expiring_soon" invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'issued'"
                       decoration-danger="state == 'revoked'"
                       decoration-warning="state in ('draft', 'generated')"
                       decoration-muted="state == 'expired'"/>
            </list>
        </field>
    </record>

    <record id="view_certificate_kanban" model="ir.ui.view">
        <field name="name">op.certificate.kanban</field>
        <field name="model">op.certificate</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_card #{record.state.raw_value == 'issued' ? 'border-success' : record.state.raw_value == 'revoked' ? 'border-danger' : 'border-warning'}">
                            <div class="fw-bold">
                                <field name="certificate_number"/>
                            </div>
                            <div>
                                <field name="student_id"/>
                            </div>
                            <div class="text-muted">
                                <field name="certificate_type_id"/>
                            </div>
                            <div class="text-muted">
                                <field name="issue_date"/>
                                <t t-if="record.expiry_date.raw_value"> - <field name="expiry_date"/></t>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_certificate_calendar" model="ir.ui.view">
        <field name="name">op.certificate.calendar</field>
        <field name="model">op.certificate</field>
        <field name="arch" type="xml">
            <calendar string="Certificates" date_start="issue_date" color="certificate_type_id" mode="month">
                <field name="student_id"/>
                <field name="certificate_type_id"/>
            </calendar>
        </field>
    </record>

    <record id="view_certificate_form" model="ir.ui.view">
        <field name="name">op.certificate.form</field>
        <field name="model">op.certificate</field>
        <field name="arch" type="xml">
            <form string="Certificate">
                <header>
                    <button string="Generate" type="object" name="action_generate" class="btn-primary" invisible="state != 'draft'"/>
                    <field name="type_requires_approval" invisible="1"/>
                    <button string="Approve" type="object" name="action_approve" class="btn-primary"
                            invisible="not (state == 'generated' and type_requires_approval and not approved_by)"/>
                    <button string="Issue" type="object" name="action_issue" class="btn-primary" invisible="state != 'generated'"/>
                    <button string="Print" type="object" name="action_print" invisible="state not in ('issued', 'revoked', 'expired')"/>
                    <button string="Revoke" type="object" name="action_open_revoke_wizard" invisible="state != 'issued'" groups="group_certificate_manager"/>
                    <button string="Reset to Draft" type="object" name="action_reset_to_draft" invisible="state != 'generated'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,generated,issued"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="certificate_number" placeholder="New" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="certificate_type_id"/>
                            <field name="course_id"/>
                            <field name="batch_id" domain="[('course_id', '=', course_id)]"/>
                            <field name="subject_id"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="issued_by"/>
                            <field name="approved_by" invisible="not approved_by"/>
                            <field name="verification_code" readonly="1"/>
                        </group>
                    </group>
                    <group string="Revocation" invisible="state != 'revoked'">
                        <field name="revoke_reason" nolabel="1" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Remarks" name="remarks">
                            <field name="remarks"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_certificate_search" model="ir.ui.view">
        <field name="name">op.certificate.search</field>
        <field name="model">op.certificate</field>
        <field name="arch" type="xml">
            <search>
                <field name="certificate_number"/>
                <field name="student_id"/>
                <field name="certificate_type_id"/>
                <field name="course_id"/>
                <field name="batch_id"/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Issued" name="filter_issued" domain="[('state', '=', 'issued')]"/>
                <filter string="Revoked" name="filter_revoked" domain="[('state', '=', 'revoked')]"/>
                <separator/>
                <filter string="Expiring in 30 Days" name="filter_expiring_soon"
                        domain="[('expiring_soon', '=', True)]"/>
                <separator/>
                <group>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Certificate Type" name="group_type" context="{'group_by': 'certificate_type_id'}"/>
                    <filter string="Course" name="group_course" context="{'group_by': 'course_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_certificate" model="ir.actions.act_window">
        <field name="name">Certificates</field>
        <field name="res_model">op.certificate</field>
        <field name="view_mode">list,kanban,calendar,form</field>
        <field name="search_view_id" ref="view_certificate_search"/>
        <field name="context">{'search_default_filter_issued': 0}</field>
    </record>
</odoo>
