<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_certificate_type_list" model="ir.ui.view">
        <field name="name">op.certificate.type.list</field>
        <field name="model">op.certificate.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="validity_months"/>
                <field name="requires_approval"/>
                <field name="certificate_count"/>
            </list>
        </field>
    </record>

    <record id="view_certificate_type_form" model="ir.ui.view">
        <field name="name">op.certificate.type.form</field>
        <field name="model">op.certificate.type</field>
        <field name="arch" type="xml">
            <form string="Certificate Type">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_certificates" icon="fa-certificate">
                            <field string="Certificates" name="certificate_count" widget="statinfo"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="category"/>
                        </group>
                        <group>
                            <field name="validity_months"/>
                            <field name="requires_approval"/>
                            <field name="sequence_id" readonly="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Custom Certificate Text" name="body">
                            <field name="body_html"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_certificate_type" model="ir.actions.act_window">
        <field name="name">Certificate Types</field>
        <field name="res_model">op.certificate.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
