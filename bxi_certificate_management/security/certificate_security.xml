<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_certificate_management" model="ir.module.category">
        <field name="name">Certificate Management</field>
        <field name="sequence">26</field>
    </record>

    <record id="privilege_certificate_management" model="res.groups.privilege">
        <field name="name">Certificate Management</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_certificate_management"/>
    </record>

    <record id="group_certificate_user" model="res.groups">
        <field name="name">Certificate User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_certificate_management"/>
    </record>

    <record id="group_certificate_manager" model="res.groups">
        <field name="name">Certificate Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_certificate_management"/>
        <field name="implied_ids" eval="[(4, ref('group_certificate_user'))]"/>
    </record>
</odoo>
