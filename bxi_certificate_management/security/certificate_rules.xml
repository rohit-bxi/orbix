<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="certificate_rule_staff" model="ir.rule">
        <field name="name">Certificate: Staff/Manager see all</field>
        <field name="model_id" ref="model_op_certificate"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_certificate_user'))]"/>
    </record>

    <record id="certificate_rule_portal" model="ir.rule">
        <field name="name">Certificate: Portal user sees own only</field>
        <field name="model_id" ref="model_op_certificate"/>
        <field name="domain_force">[('student_id.user_id', '=', user.id), ('state', '=', 'issued')]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="certificate_rule_company" model="ir.rule">
        <field name="name">Certificate: Multi-company</field>
        <field name="model_id" ref="model_op_certificate"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
