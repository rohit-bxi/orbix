<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_report_certificate" model="ir.actions.report">
        <field name="name">Certificate</field>
        <field name="model">op.certificate</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bxi_certificate_management.certificate_pdf_template</field>
        <field name="report_file">bxi_certificate_management.certificate_pdf_template</field>
        <field name="print_report_name">'Certificate - %s' % (object.certificate_number or object.student_id.name)</field>
        <field name="binding_model_id" ref="model_op_certificate"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
