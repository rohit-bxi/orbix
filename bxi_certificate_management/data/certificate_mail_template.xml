<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_certificate_expiry" model="mail.template">
            <field name="name">Certificate Management: Expiry Reminder</field>
            <field name="model_id" ref="model_op_certificate"/>
            <field name="subject">Your {{ object.certificate_type_id.name }} is expiring soon</field>
            <field name="email_to">{{ object.student_id.email }}</field>
            <field name="use_default_to" eval="False"/>
            <field name="description">Sent to a student when their certificate is approaching its expiry date.</field>
            <field name="body_html" type="html">
<div>
    Dear <t t-out="object.student_id.name or 'Student'">Student</t>,<br/><br/>
    Your <strong><t t-out="object.certificate_type_id.name or ''">Certificate</t></strong>
    (No. <t t-out="object.certificate_number or ''"/>) will expire on
    <strong><t t-out="format_date(object.expiry_date)"/></strong>.<br/><br/>
    Please contact the school office if you need it renewed or re-issued.<br/><br/>
    Regards,<br/>
    <t t-out="object.company_id.name or ''"/>
</div>
            </field>
        </record>
    </data>
</odoo>
