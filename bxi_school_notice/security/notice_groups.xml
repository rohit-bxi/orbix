<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_notice" model="ir.module.category">
        <field name="name">Notice Board</field>
        <field name="sequence">28</field>
    </record>

    <record id="privilege_notice" model="res.groups.privilege">
        <field name="name">Notice Board</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_notice"/>
    </record>

    <record id="group_notice_manager" model="res.groups">
        <field name="name">Notice Manager</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_notice"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
