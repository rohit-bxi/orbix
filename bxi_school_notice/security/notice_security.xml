<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="notice_rule_manager" model="ir.rule">
        <field name="name">Notice: Manager sees all</field>
        <field name="model_id" ref="model_bxi_notice"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('group_notice_manager')])]"/>
    </record>

    <record id="notice_rule_reader" model="ir.rule">
        <field name="name">Notice: Other internal users see active notices only</field>
        <field name="model_id" ref="model_bxi_notice"/>
        <field name="domain_force">[('active', '=', True)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

    <record id="notice_rule_company" model="ir.rule">
        <field name="name">Notice: Multi-company</field>
        <field name="model_id" ref="model_bxi_notice"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
