<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_lab_management" model="ir.module.category">
        <field name="name">Lab Management</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_lab_instructor" model="res.groups">
        <field name="name">Lab Instructor</field>
    </record>

    <record id="group_lab_admin" model="res.groups">
        <field name="name">Lab Administrator</field>
        <field name="implied_ids" eval="[(4, ref('group_lab_instructor'))]"/>
    </record>

    <!-- Instructor: only own sessions -->
    <record id="lab_session_rule_instructor" model="ir.rule">
        <field name="name">Lab Session: Instructor sees own sessions</field>
        <field name="model_id" ref="model_lab_session"/>
        <field name="domain_force">[('faculty_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_lab_instructor'))]"/>
    </record>

    <record id="lab_session_rule_admin" model="ir.rule">
        <field name="name">Lab Session: Admin sees all</field>
        <field name="model_id" ref="model_lab_session"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_lab_admin'))]"/>
    </record>
</odoo>
