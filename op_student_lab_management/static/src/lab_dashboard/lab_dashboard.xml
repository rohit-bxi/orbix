<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="op_student_lab_management.LabDashboard">
        <div class="o_lab_dashboard h-100 overflow-auto p-3">
            <div class="o_lab_dashboard_header mb-4">
                <h2 class="mb-1">Lab Management Dashboard</h2>
                <div class="text-muted">Sessions, attendance, equipment and experiment activity at a glance.</div>
            </div>

            <!-- KPI cards -->
            <div class="row g-3 mb-4">
                <t t-foreach="kpiDefs" t-as="def" t-key="def.key">
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="o_lab_kpi_card">
                            <div t-attf-class="o_lab_kpi_icon o_lab_kpi_icon_{{def.color}}">
                                <i t-attf-class="fa {{def.icon}}"/>
                            </div>
                            <div class="o_lab_kpi_value" t-esc="formatKpi(def)"/>
                            <div class="o_lab_kpi_label" t-esc="def.label"/>
                        </div>
                    </div>
                </t>
            </div>

            <!-- Recent Sessions -->
            <div class="o_lab_dashboard_panel mb-4">
                <div class="o_lab_dashboard_panel_header d-flex justify-content-between align-items-center">
                    <span>Recent Sessions</span>
                    <button type="button" class="btn btn-primary btn-sm" t-on-click="viewAllSessions">View All</button>
                </div>
                <div class="table-responsive">
                    <table class="table o_lab_table mb-0">
                        <thead>
                            <tr>
                                <th>Room</th>
                                <th>Course / Batch</th>
                                <th>Instructor</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-if="!state.sessionList.length">
                                <td colspan="6" class="text-muted text-center py-3">No lab sessions found</td>
                            </tr>
                            <tr t-foreach="state.sessionList" t-as="row" t-key="row.id">
                                <td t-esc="row.room"/>
                                <td t-esc="row.course_batch"/>
                                <td t-esc="row.instructor"/>
                                <td t-esc="row.date"/>
                                <td>
                                    <span t-attf-class="badge {{statusBadgeClass(row.state)}}" t-esc="stateLabel(row.state)"/>
                                </td>
                                <td>
                                    <a href="#" class="o_lab_row_action" t-on-click.prevent="() => this.openRecord(row.id)" title="View">
                                        <i class="fa fa-eye"/>
                                    </a>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Charts row 1 -->
            <div class="row g-3 mb-4">
                <div class="col-12 col-lg-6">
                    <div class="o_lab_dashboard_panel h-100">
                        <div class="o_lab_dashboard_panel_header">Session Status Distribution</div>
                        <div class="o_lab_chart_container p-3">
                            <canvas t-ref="statusDistribution"/>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6">
                    <div class="o_lab_dashboard_panel h-100">
                        <div class="o_lab_dashboard_panel_header">Lab Type Distribution</div>
                        <div class="o_lab_chart_container p-3">
                            <canvas t-ref="labTypeDistribution"/>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Attendance Distribution -->
            <div class="o_lab_dashboard_panel mb-4">
                <div class="o_lab_dashboard_panel_header">Attendance Distribution</div>
                <div class="o_lab_chart_container_lg p-3">
                    <canvas t-ref="attendanceDistribution"/>
                </div>
            </div>

            <!-- Equipment Needing Attention -->
            <div class="o_lab_dashboard_panel mb-4">
                <div class="o_lab_dashboard_panel_header">Equipment Needing Attention</div>
                <div class="table-responsive">
                    <table class="table o_lab_table mb-0">
                        <thead>
                            <tr>
                                <th>Equipment</th>
                                <th>Lab Room</th>
                                <th>Condition</th>
                                <th>Available</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-if="!state.equipmentAttention.length">
                                <td colspan="4" class="text-muted text-center py-3">No equipment needs attention</td>
                            </tr>
                            <tr t-foreach="state.equipmentAttention" t-as="item" t-key="item_index">
                                <td t-esc="item.name"/>
                                <td t-esc="item.lab_room"/>
                                <td t-esc="item.condition"/>
                                <td t-esc="item.quantity_available"/>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Monthly Session Trend -->
            <div class="o_lab_dashboard_panel mb-4">
                <div class="o_lab_dashboard_panel_header">Monthly Session Trend</div>
                <div class="o_lab_chart_container_lg p-3">
                    <canvas t-ref="monthlyTrend"/>
                </div>
            </div>

            <!-- Secondary stats -->
            <div class="row g-3 mb-4">
                <t t-foreach="statDefs" t-as="def" t-key="def.key">
                    <div class="col-12 col-md-4">
                        <div class="o_lab_kpi_card">
                            <div class="o_lab_kpi_value" t-esc="formatStat(def)"/>
                            <div class="o_lab_kpi_label" t-esc="def.label"/>
                        </div>
                    </div>
                </t>
            </div>

            <!-- Recent Activity -->
            <div class="o_lab_dashboard_panel mb-4">
                <div class="o_lab_dashboard_panel_header">Recent Activity</div>
                <div class="p-3">
                    <div t-if="!state.recentActivity.length" class="text-muted">No recent activity</div>
                    <div t-foreach="state.recentActivity" t-as="activity" t-key="activity_index"
                         class="o_lab_activity_row d-flex justify-content-between align-items-start">
                        <div>
                            <div class="fw-semibold" t-esc="activity.title"/>
                            <div class="text-muted small" t-esc="activity.date"/>
                        </div>
                        <span t-attf-class="badge {{activityBadgeClass(activity.kind)}}" t-esc="activity.kind"/>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
