<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lab_equipment_issue_list" model="ir.ui.view">
        <field name="name">lab.equipment.issue.list</field>
        <field name="model">lab.equipment.issue</field>
        <field name="arch" type="xml">
            <list string="Equipment Issue Log" decoration-warning="state=='partial'" decoration-danger="state=='damaged'" decoration-success="state=='returned'">
                <field name="session_id"/>
                <field name="equipment_id"/>
                <field name="student_id"/>
                <field name="issue_date"/>
                <field name="issued_qty"/>
                <field name="returned_qty"/>
                <field name="return_date"/>
                <field name="state"/>
                <button name="action_return" string="Return" type="object" invisible="state in ('returned', 'damaged')"/>
            </list>
        </field>
    </record>

    <record id="action_lab_equipment_issue" model="ir.actions.act_window">
        <field name="name">Equipment Issue Log</field>
        <field name="res_model">lab.equipment.issue</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
