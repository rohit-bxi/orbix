<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lab_attendance_list" model="ir.ui.view">
        <field name="name">lab.attendance.list</field>
        <field name="model">lab.attendance</field>
        <field name="arch" type="xml">
            <list string="Lab Attendance" editable="bottom">
                <field name="date"/>
                <field name="session_id"/>
                <field name="room_id"/>
                <field name="student_id"/>
                <field name="status"/>
                <field name="remark"/>
            </list>
        </field>
    </record>

    <record id="action_lab_attendance" model="ir.actions.act_window">
        <field name="name">Lab Attendance</field>
        <field name="res_model">lab.attendance</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
