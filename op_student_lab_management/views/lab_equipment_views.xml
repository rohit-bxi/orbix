<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lab_equipment_list" model="ir.ui.view">
        <field name="name">lab.equipment.list</field>
        <field name="model">lab.equipment</field>
        <field name="arch" type="xml">
            <list string="Lab Equipment">
                <field name="code"/>
                <field name="name"/>
                <field name="lab_id"/>
                <field name="quantity_total"/>
                <field name="quantity_issued"/>
                <field name="quantity_available"/>
                <field name="condition"/>
            </list>
        </field>
    </record>

    <record id="view_lab_equipment_form" model="ir.ui.view">
        <field name="name">lab.equipment.form</field>
        <field name="model">lab.equipment</field>
        <field name="arch" type="xml">
            <form string="Lab Equipment">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="lab_id"/>
                        </group>
                        <group>
                            <field name="quantity_total"/>
                            <field name="quantity_issued"/>
                            <field name="quantity_available"/>
                            <field name="condition"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_lab_equipment" model="ir.actions.act_window">
        <field name="name">Lab Equipment</field>
        <field name="res_model">lab.equipment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
