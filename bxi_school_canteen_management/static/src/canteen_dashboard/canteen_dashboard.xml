<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="bxi_school_canteen_management.CanteenDashboard">
        <div class="o_canteen_dashboard h-100 overflow-auto p-3">
            <div class="o_canteen_dashboard_header mb-4">
                <h2 class="mb-1">Canteen Dashboard</h2>
                <div class="text-muted">Kitchen orders, wallet health and sales at a glance.</div>
            </div>

            <!-- KPI cards -->
            <div class="row g-3 mb-4">
                <t t-foreach="kpiDefs" t-as="def" t-key="def.key">
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="o_canteen_kpi_card">
                            <div t-attf-class="o_canteen_kpi_icon o_canteen_kpi_icon_{{def.color}}">
                                <i t-attf-class="fa {{def.icon}}"/>
                            </div>
                            <div class="o_canteen_kpi_value" t-esc="formatKpi(def)"/>
                            <div class="o_canteen_kpi_label" t-esc="def.label"/>
                        </div>
                    </div>
                </t>
            </div>

            <!-- Recent Orders -->
            <div class="o_canteen_dashboard_panel mb-4">
                <div class="o_canteen_dashboard_panel_header d-flex justify-content-between align-items-center">
                    <span>Recent Orders</span>
                    <button type="button" class="btn btn-primary btn-sm" t-on-click="viewAllOrders">View All</button>
                </div>
                <div class="table-responsive">
                    <table class="table o_canteen_table mb-0">
                        <thead>
                            <tr>
                                <th>Patron</th>
                                <th>Amount</th>
                                <th>Order Time</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-if="!state.orderList.length">
                                <td colspan="5" class="text-muted text-center py-3">No canteen orders found</td>
                            </tr>
                            <tr t-foreach="state.orderList" t-as="row" t-key="row.id">
                                <td t-esc="row.patron_name"/>
                                <td t-esc="formatAmount(row.total_amount)"/>
                                <td t-esc="row.order_datetime"/>
                                <td>
                                    <span t-attf-class="badge {{statusBadgeClass(row.state)}}" t-esc="stateLabel(row.state)"/>
                                </td>
                                <td>
                                    <a href="#" class="o_canteen_row_action" t-on-click.prevent="() => this.openRecord(row.id)" title="View">
                                        <i class="fa fa-eye"/>
                                    </a>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Charts row 1 -->
            <div class="row g-3 mb-4">
                <div class="col-12 col-lg-6">
                    <div class="o_canteen_dashboard_panel h-100">
                        <div class="o_canteen_dashboard_panel_header">Order Status Distribution</div>
                        <div class="o_canteen_chart_container p-3">
                            <canvas t-ref="statusDistribution"/>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6">
                    <div class="o_canteen_dashboard_panel h-100">
                        <div class="o_canteen_dashboard_panel_header">Wallet Health</div>
                        <div class="p-3">
                            <t t-set="wallets" t-value="state.chartsData.wallet_health"/>
                            <t t-if="wallets">
                                <div class="o_canteen_stat_row">
                                    <div class="d-flex justify-content-between">
                                        <span>Total Wallets</span>
                                        <span class="fw-semibold" t-esc="wallets.total"/>
                                    </div>
                                    <div class="o_canteen_progress"><div class="o_canteen_progress_bar o_canteen_progress_blue" style="width: 100%"/></div>
                                </div>
                                <div class="o_canteen_stat_row">
                                    <div class="d-flex justify-content-between">
                                        <span>Healthy Balance</span>
                                        <span class="fw-semibold" t-esc="wallets.healthy"/>
                                    </div>
                                    <div class="o_canteen_progress">
                                        <div class="o_canteen_progress_bar o_canteen_progress_green"
                                             t-attf-style="width: {{wallets.total ? (wallets.healthy / wallets.total * 100) : 0}}%"/>
                                    </div>
                                </div>
                                <div class="o_canteen_stat_row">
                                    <div class="d-flex justify-content-between">
                                        <span>Low Balance</span>
                                        <span class="fw-semibold" t-esc="wallets.low_balance"/>
                                    </div>
                                    <div class="o_canteen_progress">
                                        <div class="o_canteen_progress_bar o_canteen_progress_red"
                                             t-attf-style="width: {{wallets.total ? (wallets.low_balance / wallets.total * 100) : 0}}%"/>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Best Selling Items -->
            <div class="o_canteen_dashboard_panel mb-4">
                <div class="o_canteen_dashboard_panel_header">Best Selling Items</div>
                <div class="o_canteen_chart_container_lg p-3">
                    <canvas t-ref="bestSellingItems"/>
                </div>
            </div>

            <!-- Low Balance Wallets -->
            <div class="o_canteen_dashboard_panel mb-4">
                <div class="o_canteen_dashboard_panel_header">Wallets Needing Top-up</div>
                <div class="table-responsive">
                    <table class="table o_canteen_table mb-0">
                        <thead>
                            <tr>
                                <th>Patron</th>
                                <th>Balance</th>
                                <th>Threshold</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-if="!state.lowBalanceWallets.length">
                                <td colspan="3" class="text-muted text-center py-3">No low-balance wallets</td>
                            </tr>
                            <tr t-foreach="state.lowBalanceWallets" t-as="wallet" t-key="wallet_index">
                                <td t-esc="wallet.patron_name"/>
                                <td t-esc="formatAmount(wallet.balance)"/>
                                <td t-esc="formatAmount(wallet.threshold)"/>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Monthly Revenue Trend -->
            <div class="o_canteen_dashboard_panel mb-4">
                <div class="o_canteen_dashboard_panel_header">Monthly Revenue Trend</div>
                <div class="o_canteen_chart_container_lg p-3">
                    <canvas t-ref="monthlyTrend"/>
                </div>
            </div>

            <!-- Secondary stats -->
            <div class="row g-3 mb-4">
                <t t-foreach="statDefs" t-as="def" t-key="def.key">
                    <div class="col-12 col-md-4">
                        <div class="o_canteen_kpi_card">
                            <div class="o_canteen_kpi_value" t-esc="formatStat(def)"/>
                            <div class="o_canteen_kpi_label" t-esc="def.label"/>
                        </div>
                    </div>
                </t>
            </div>

            <!-- Recent Activity -->
            <div class="o_canteen_dashboard_panel mb-4">
                <div class="o_canteen_dashboard_panel_header">Recent Activity</div>
                <div class="p-3">
                    <div t-if="!state.recentActivity.length" class="text-muted">No recent activity</div>
                    <div t-foreach="state.recentActivity" t-as="activity" t-key="activity_index"
                         class="o_canteen_activity_row d-flex justify-content-between align-items-start">
                        <div>
                            <div class="fw-semibold" t-esc="activity.title"/>
                            <div class="text-muted small" t-esc="activity.date"/>
                        </div>
                        <span t-attf-class="badge {{activityBadgeClass(activity.kind)}}" t-esc="activity.kind"/>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
