<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_report_canteen_wallet_statement" model="ir.actions.report">
        <field name="name">Wallet Statement</field>
        <field name="model">bxi.canteen.wallet.statement.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bxi_school_canteen_management.canteen_wallet_statement_pdf_template</field>
        <field name="report_file">bxi_school_canteen_management.canteen_wallet_statement_pdf_template</field>
        <field name="print_report_name">'canteen-wallet-statement'</field>
        <field name="binding_type">report</field>
    </record>

    <template id="canteen_wallet_statement_pdf_template">
        <t t-call="web.basic_layout">
            <div class="page">
                <h1 style="text-align:center;text-decoration:underline;">Canteen Wallet Statement</h1>
                <p>Patron: <strong><t t-out="patron_name"/></strong></p>
                <span>From date: <t t-out="from_date"/></span>&#160;&#160;<span>To Date: <t t-out="to_date"/></span>
                <br/>
                <p>Opening Balance: <t t-out="opening_balance"/></p>
                <table class="table table-bordered" style="width:100%">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Amount</th>
                            <th>Running Balance</th>
                            <th>Note</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="all_data" t-as="data">
                            <tr>
                                <td t-out="data['date']"/>
                                <td t-out="data['transaction_type']"/>
                                <td t-out="data['amount']"/>
                                <td t-out="data['running_balance']"/>
                                <td t-out="data['note']"/>
                            </tr>
                        </t>
                    </tbody>
                </table>
                <p>Closing Balance: <strong><t t-out="closing_balance"/></strong></p>
            </div>
        </t>
    </template>
</odoo>
