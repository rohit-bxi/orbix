<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_canteen_wallet_transaction_list" model="ir.ui.view">
        <field name="name">bxi.canteen.wallet.transaction.list</field>
        <field name="model">bxi.canteen.wallet.transaction</field>
        <field name="arch" type="xml">
            <list string="Wallet Transactions" decoration-success="amount &gt; 0" decoration-danger="amount &lt; 0" create="false">
                <field name="name"/>
                <field name="date"/>
                <field name="wallet_id"/>
                <field name="transaction_type"/>
                <field name="amount"/>
                <field name="payment_method" optional="hide"/>
                <field name="order_id" optional="hide"/>
                <field name="processed_by" optional="hide"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_canteen_wallet_transaction_form" model="ir.ui.view">
        <field name="name">bxi.canteen.wallet.transaction.form</field>
        <field name="model">bxi.canteen.wallet.transaction</field>
        <field name="arch" type="xml">
            <form string="Wallet Transaction" create="false">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="wallet_id" readonly="1"/>
                            <field name="transaction_type" readonly="1"/>
                            <field name="amount" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="date" readonly="1"/>
                        </group>
                        <group>
                            <field name="order_id" readonly="1"/>
                            <field name="payment_method" readonly="1"/>
                            <field name="account_payment_id" readonly="1"/>
                            <field name="processed_by" readonly="1"/>
                            <field name="state" widget="badge"/>
                            <field name="note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_canteen_wallet_transaction_search" model="ir.ui.view">
        <field name="name">bxi.canteen.wallet.transaction.search</field>
        <field name="model">bxi.canteen.wallet.transaction</field>
        <field name="arch" type="xml">
            <search string="Wallet Transactions">
                <field name="name"/>
                <field name="wallet_id"/>
                <field name="order_id"/>
                <group name="group_by">
                    <filter string="Type" name="group_type" context="{'group_by': 'transaction_type'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_canteen_wallet_transaction" model="ir.actions.act_window">
        <field name="name">Wallet Transactions</field>
        <field name="res_model">bxi.canteen.wallet.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_canteen_wallet_transaction_search"/>
        <field name="context">{'create': False}</field>
    </record>
</odoo>
