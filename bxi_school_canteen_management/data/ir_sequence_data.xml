<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_canteen_wallet_transaction" model="ir.sequence">
        <field name="name">Canteen Wallet Transaction</field>
        <field name="code">bxi.canteen.wallet.transaction</field>
        <field name="prefix">WTX/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_canteen_order" model="ir.sequence">
        <field name="name">Canteen Order</field>
        <field name="code">bxi.canteen.order</field>
        <field name="prefix">ORD/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
