<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_canteen" model="ir.module.category">
        <field name="name">Canteen</field>
        <field name="sequence">26</field>
    </record>

    <record id="privilege_canteen" model="res.groups.privilege">
        <field name="name">Canteen</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_canteen"/>
    </record>

    <record id="group_canteen_staff" model="res.groups">
        <field name="name">Canteen Staff</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_canteen"/>
    </record>

    <record id="group_canteen_manager" model="res.groups">
        <field name="name">Canteen Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_canteen"/>
        <field name="implied_ids" eval="[(4, ref('group_canteen_staff'))]"/>
    </record>
</odoo>
