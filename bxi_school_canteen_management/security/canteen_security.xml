<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- bxi.canteen.wallet -->
    <record id="canteen_wallet_rule_staff" model="ir.rule">
        <field name="name">Canteen Wallet: Staff/Manager see all</field>
        <field name="model_id" ref="model_bxi_canteen_wallet"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_canteen_staff'))]"/>
    </record>

    <record id="canteen_wallet_rule_self" model="ir.rule">
        <field name="name">Canteen Wallet: Self read-only</field>
        <field name="model_id" ref="model_bxi_canteen_wallet"/>
        <field name="domain_force">['|', ('student_id.user_id', '=', user.id), ('faculty_id.partner_id.user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

    <record id="canteen_wallet_rule_company" model="ir.rule">
        <field name="name">Canteen Wallet: Multi-company</field>
        <field name="model_id" ref="model_bxi_canteen_wallet"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

