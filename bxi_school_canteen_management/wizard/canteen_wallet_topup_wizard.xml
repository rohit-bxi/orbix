<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_canteen_wallet_topup_wizard_form" model="ir.ui.view">
        <field name="name">bxi.canteen.wallet.topup.wizard.form</field>
        <field name="model">bxi.canteen.wallet.topup.wizard</field>
        <field name="arch" type="xml">
            <form string="Top Up Wallet">
                <group>
                    <field name="patron_type"/>
                    <field name="student_id" invisible="patron_type != 'student'" required="patron_type == 'student'"/>
                    <field name="faculty_id" invisible="patron_type != 'faculty'" required="patron_type == 'faculty'"/>
                    <field name="amount"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="payment_method"/>
                    <field name="post_to_accounting"/>
                    <field name="journal_id" invisible="not post_to_accounting" required="post_to_accounting"/>
                </group>
                <footer>
                    <button string="Top Up" class="btn btn-primary" type="object" name="action_topup" icon="fa-plus-circle"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_canteen_wallet_topup_wizard" model="ir.actions.act_window">
        <field name="name">Top Up Wallet</field>
        <field name="res_model">bxi.canteen.wallet.topup.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
