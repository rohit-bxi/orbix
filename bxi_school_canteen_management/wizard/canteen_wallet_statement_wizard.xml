<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_canteen_wallet_statement_wizard_form" model="ir.ui.view">
        <field name="name">bxi.canteen.wallet.statement.wizard.form</field>
        <field name="model">bxi.canteen.wallet.statement.wizard</field>
        <field name="arch" type="xml">
            <form string="Wallet Statement">
                <group>
                    <field name="patron_type"/>
                    <field name="student_id" invisible="patron_type != 'student'" required="patron_type == 'student'"/>
                    <field name="faculty_id" invisible="patron_type != 'faculty'" required="patron_type == 'faculty'"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button string="Print" class="btn btn-primary" type="object" name="statement_report" icon="fa-print"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_canteen_wallet_statement_wizard" model="ir.actions.act_window">
        <field name="name">Wallet Statement Report</field>
        <field name="res_model">bxi.canteen.wallet.statement.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
