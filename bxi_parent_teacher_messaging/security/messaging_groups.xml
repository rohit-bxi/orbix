<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_messaging" model="ir.module.category">
        <field name="name">Parent-Teacher Messaging</field>
        <field name="sequence">31</field>
    </record>

    <record id="privilege_messaging" model="res.groups.privilege">
        <field name="name">Parent-Teacher Messaging</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_messaging"/>
    </record>

    <record id="group_messaging_auditor" model="res.groups">
        <field name="name">Messaging Auditor</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_messaging"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
