<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_bxi_message_thread_list" model="ir.ui.view">
        <field name="name">bxi.message.thread.list</field>
        <field name="model">bxi.message.thread</field>
        <field name="arch" type="xml">
            <list string="Parent-Teacher Threads" create="false" edit="false" delete="false">
                <field name="student_id"/>
                <field name="parent_id"/>
                <field name="teacher_id"/>
                <field name="message_count"/>
                <field name="last_message_at"/>
            </list>
        </field>
    </record>

    <record id="view_bxi_message_thread_form" model="ir.ui.view">
        <field name="name">bxi.message.thread.form</field>
        <field name="model">bxi.message.thread</field>
        <field name="arch" type="xml">
            <form string="Parent-Teacher Thread" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <field name="student_id"/>
                        <field name="parent_id"/>
                        <field name="teacher_id"/>
                    </group>
                    <field name="message_ids" readonly="1">
                        <list>
                            <field name="create_date"/>
                            <field name="sender_user_id"/>
                            <field name="body"/>
                            <field name="read_at"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bxi_message_thread" model="ir.actions.act_window">
        <field name="name">Parent-Teacher Threads</field>
        <field name="res_model">bxi.message.thread</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_message_thread" name="Messaging Audit" parent="bxi_api.menu_api_root" action="action_bxi_message_thread" sequence="30"
              groups="bxi_parent_teacher_messaging.group_messaging_auditor"/>
</odoo>
