<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.bxi.online.fee.payment</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Orbix Payments" name="bxi_online_fee_payment" logo="/bxi_online_fee_payment/static/description/icon.png">
                    <block title="Razorpay" help="The mobile app owns the checkout UI and Razorpay SDK - these credentials are only used server-side to create orders and verify payments.">
                        <setting id="razorpay_key_id" string="Key ID">
                            <field name="razorpay_key_id"/>
                        </setting>
                        <setting id="razorpay_key_secret" string="Key Secret">
                            <field name="razorpay_key_secret" password="True"/>
                        </setting>
                        <setting id="razorpay_webhook_secret" string="Webhook Secret">
                            <field name="razorpay_webhook_secret" password="True"/>
                        </setting>
                        <setting id="online_payment_journal_id" string="Online Payment Journal">
                            <field name="online_payment_journal_id"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
