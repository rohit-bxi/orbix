<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_bxi_payment_order_list" model="ir.ui.view">
        <field name="name">bxi.payment.order.list</field>
        <field name="model">bxi.payment.order</field>
        <field name="arch" type="xml">
            <list string="Online Payment Orders" create="false" edit="false" delete="false">
                <field name="student_id"/>
                <field name="fees_detail_id"/>
                <field name="amount"/>
                <field name="razorpay_order_id"/>
                <field name="razorpay_payment_id"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'paid'"
                       decoration-danger="status == 'failed'"
                       decoration-info="status == 'created'"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="action_bxi_payment_order" model="ir.actions.act_window">
        <field name="name">Online Payment Orders</field>
        <field name="res_model">bxi.payment.order</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_payment_order" name="Payment Orders" parent="bxi_api.menu_api_root" action="action_bxi_payment_order" sequence="20"/>
</odoo>
