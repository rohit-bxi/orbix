<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="visitor_management.BxiVisitorDashboard">
        <div class="o_visitor_dashboard h-100 overflow-auto p-3">
            <div class="o_visitor_dashboard_header mb-4">
                <h2 class="mb-1">Visitor Management Dashboard</h2>
                <div class="text-muted">Check-ins, check-outs and visitor activity at a glance.</div>
            </div>

            <!-- KPI cards -->
            <div class="row g-3 mb-4">
                <t t-foreach="kpiDefs" t-as="def" t-key="def.key">
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="o_visitor_kpi_card">
                            <div t-attf-class="o_visitor_kpi_icon o_visitor_kpi_icon_{{def.color}}">
                                <i t-attf-class="fa {{def.icon}}"/>
                            </div>
                            <div class="o_visitor_kpi_value" t-esc="formatKpi(def)"/>
                            <div class="o_visitor_kpi_label" t-esc="def.label"/>
                        </div>
                    </div>
                </t>
            </div>

            <!-- Recent Visits -->
            <div class="o_visitor_dashboard_panel mb-4">
                <div class="o_visitor_dashboard_panel_header d-flex justify-content-between align-items-center">
                    <span>Recent Visits</span>
                    <button type="button" class="btn btn-primary btn-sm" t-on-click="viewAllVisits">View All</button>
                </div>
                <div class="table-responsive">
                    <table class="table o_visitor_table mb-0">
                        <thead>
                            <tr>
                                <th>Visitor</th>
                                <th>Company</th>
                                <th>Host</th>
                                <th>Check-In</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-if="!state.visitList.length">
                                <td colspan="6" class="text-muted text-center py-3">No visits found</td>
                            </tr>
                            <tr t-foreach="state.visitList" t-as="row" t-key="row.id">
                                <td t-esc="row.visitor_name"/>
                                <td t-esc="row.company"/>
                                <td t-esc="row.host"/>
                                <td t-esc="row.check_in_date"/>
                                <td>
                                    <span t-attf-class="badge {{statusBadgeClass(row.state)}}" t-esc="stateLabel(row.state)"/>
                                </td>
                                <td>
                                    <a href="#" class="o_visitor_row_action" t-on-click.prevent="() => this.openRecord(row.id)" title="View">
                                        <i class="fa fa-eye"/>
                                    </a>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Charts row 1 -->
            <div class="row g-3 mb-4">
                <div class="col-12 col-lg-6">
                    <div class="o_visitor_dashboard_panel h-100">
                        <div class="o_visitor_dashboard_panel_header">Visit Status Distribution</div>
                        <div class="o_visitor_chart_container p-3">
                            <canvas t-ref="statusDistribution"/>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6">
                    <div class="o_visitor_dashboard_panel h-100">
                        <div class="o_visitor_dashboard_panel_header">Visitor Type Distribution</div>
                        <div class="o_visitor_chart_container p-3">
                            <canvas t-ref="typeDistribution"/>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Department-wise Visits -->
            <div class="o_visitor_dashboard_panel mb-4">
                <div class="o_visitor_dashboard_panel_header">Department-wise Visits</div>
                <div class="o_visitor_chart_container_lg p-3">
                    <canvas t-ref="departmentWise"/>
                </div>
            </div>

            <!-- Top Hosts -->
            <div class="o_visitor_dashboard_panel mb-4">
                <div class="o_visitor_dashboard_panel_header">Most Visited Employees</div>
                <div class="table-responsive">
                    <table class="table o_visitor_table mb-0">
                        <thead>
                            <tr>
                                <th>Employee</th>
                                <th>Department</th>
                                <th>Visits Hosted</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-if="!state.topHosts.length">
                                <td colspan="3" class="text-muted text-center py-3">No hosted visits found</td>
                            </tr>
                            <tr t-foreach="state.topHosts" t-as="host" t-key="host.name">
                                <td t-esc="host.name"/>
                                <td t-esc="host.department"/>
                                <td t-esc="host.visit_count"/>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Monthly Visit Trend -->
            <div class="o_visitor_dashboard_panel mb-4">
                <div class="o_visitor_dashboard_panel_header">Monthly Visit Trend</div>
                <div class="o_visitor_chart_container_lg p-3">
                    <canvas t-ref="monthlyTrend"/>
                </div>
            </div>

            <!-- Secondary stats -->
            <div class="row g-3 mb-4">
                <t t-foreach="statDefs" t-as="def" t-key="def.key">
                    <div class="col-12 col-md-4">
                        <div class="o_visitor_kpi_card">
                            <div class="o_visitor_kpi_value" t-esc="formatStat(def)"/>
                            <div class="o_visitor_kpi_label" t-esc="def.label"/>
                        </div>
                    </div>
                </t>
            </div>

            <!-- Recent Activity -->
            <div class="o_visitor_dashboard_panel mb-4">
                <div class="o_visitor_dashboard_panel_header">Recent Activity</div>
                <div class="p-3">
                    <div t-if="!state.recentActivity.length" class="text-muted">No recent activity</div>
                    <div t-foreach="state.recentActivity" t-as="activity" t-key="activity_index"
                         class="o_visitor_activity_row d-flex justify-content-between align-items-start">
                        <div>
                            <div class="fw-semibold" t-esc="activity.title"/>
                            <div class="text-muted small" t-esc="activity.date"/>
                        </div>
                        <span t-attf-class="badge {{activityBadgeClass(activity.kind)}}" t-esc="activity.kind"/>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
